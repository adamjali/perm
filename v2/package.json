{
  "name": "v2",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint --fix --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:convex",
    "typecheck:app": "tsgo --noEmit",
    "typecheck:convex": "tsc -p convex --noEmit",
    "audit:pages": "python3 scripts/audit_all_pages.py --base https://permtracker.app",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:python": "python3 scripts/test_visa_bulletin.py",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --project unit --project unit-isolated",
    "test:components": "vitest run --project components",
    "test:convex": "vitest run --project convex",
    "test:fast": "vitest run --project unit --project unit-isolated",
    "test:perm": "vitest run convex/lib/perm/**/*.test.ts",
    "test:changed": "vitest run --changed HEAD~1",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=json --reporter=github-actions",
    "test:e2e": "./run-e2e-tests.sh",
    "test:all": "vitest run && ./run-e2e-tests.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "qa": "bash scripts/qa.sh",
    "audit:stale": "python3 scripts/audit_staleness.py",
    "audit:registration": "python3 scripts/audit_page_registration.py"
  },
