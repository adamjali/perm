# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
# Side-by-side build output. `NEXT_DIST_DIR=.next-<name> pnpm build`
# lets one session build without replacing the artifacts another
# session's server is reading. Untracked, these filled `git status`
# with thousands of build files that a blanket `git add` would commit.
/.next-*/
/out/

# production
/build

# Serwist generated service worker (build artifact, regenerated every build)
public/sw.js
public/sw.js.map

# misc
.DS_Store
*.pem
*.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry example page (auto-generated)
src/app/sentry-example-page/

*storybook.log
storybook-static

# Migration data (contains PII - user emails, OAuth tokens)
scripts/migration/data/*.jsonl
scripts/migration/data/transformed/
scripts/migration/data/verification_result.json
scripts/migration/backups/*.zip
scripts/migration/backups/latest_backup.txt
!scripts/migration/backups/.gitkeep

# Private launch/outreach docs
LAUNCH_GUIDE.md
outreach/
.env.local

# Claude Code project-local config
.claude/

# Impeccable design hook
# config.json is shared and committed (it holds the reviewed detector ignores).
# The rest is machine-local: hook.cache.json records absolute paths and session
# ids, and config.local.json holds per-developer overrides. Neither belongs in a
# public repo.
.impeccable/hook.cache.json
.impeccable/config.local.json

# Session scratch: probe dumps and analysis intermediates. The findings that
# matter are written into scripts/ and the docs; these are the raw workings.
scratchpad/

# Written by build_entity_detail.py for the revalidation step to POST. An
# ingest artifact, not source: in CI the tree is ephemeral, but a local run
# would otherwise leave it sitting untracked.
changed-employer-slugs.json
