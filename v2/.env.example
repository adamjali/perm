# Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# CONVEX (Required)
# =============================================================================
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# =============================================================================
# AUTH (Required for authentication)
# =============================================================================
# Google OAuth for auth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public site URL, used for links and OAuth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AI PROVIDERS (Required for chat functionality)
# =============================================================================
# 5 providers with 8 fallback instances for maximum availability
# Get keys from:
# - Google AI Studio: https://aistudio.google.com/
# - OpenRouter: https://openrouter.ai/keys
# - Groq: https://console.groq.com/keys
# - Cerebras: https://cloud.cerebras.ai/
# - Mistral: https://console.mistral.ai/

GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
MISTRAL_API_KEY=your_mistral_api_key

# =============================================================================
# GOOGLE CALENDAR (Required for calendar sync)
# =============================================================================
# Separate from AUTH_GOOGLE_* - different OAuth scopes. The redirect URI is
# NEXT_PUBLIC_APP_URL + /api/google/callback; register that in Google Cloud.
# Read by both Next.js and Convex, so set them in both places.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# =============================================================================
# WEB SEARCH (Required for chatbot web search)
# =============================================================================
# Multi-provider fallback: Tavily (primary) -> Brave (fallback)
# Get keys from:
# - Tavily: https://tavily.com/ (1000 free searches/month)
# - Brave: https://brave.com/search/api/ (2000 free searches/month)

TAVILY_API_KEY=your-tavily-api-key
BRAVE_API_KEY=your-brave-api-key

# =============================================================================
# ANALYTICS — PostHog (Optional, but required for product analytics)
# =============================================================================
# Public client key (browser-exposed) + US cloud host. Get from PostHog →
# Project Settings. Client init lives in src/instrumentation-client.ts and
# sends events via the /ingest reverse proxy (see next.config.ts rewrites).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# ERROR TRACKING — Sentry (Optional)
# =============================================================================
# Client + server DSN (note: sentry.server/edge.config.ts read SENTRY_DSN, the
# unprefixed one). SENTRY_AUTH_TOKEN/ORG/PROJECT are only needed at build time
# for source-map upload. See .env.sentry.example for the full list.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx
SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# =============================================================================
# DEVELOPMENT AND TESTING (Optional)
# =============================================================================
# "true" turns on the chat tool debug log (off by default; it can hold case data).
CHAT_LOG_VERBOSE=
# Build into another folder than .next, so a second local build can run beside one in progress.
NEXT_DIST_DIR=
# Base URL for the Playwright end-to-end tests (default http://localhost:3000).
BASE_URL=
# Version shown under Settings > Support (default 2.0.0).
NEXT_PUBLIC_APP_VERSION=

# =============================================================================
# CONVEX DEPLOYMENT ENVIRONMENT
# =============================================================================
# Read by Convex functions, not by Next.js: set each one on the deployment with
#   npx convex env set NAME value
# rather than in .env.local. This list covers the email, encryption and logging
# settings; see .planning/codebase/INTEGRATIONS.md for the rest.
#
# Resend API key every email is sent with.
# AUTH_RESEND_KEY=
# 64 hex characters (32 bytes). Encrypts stored Google tokens and FEINs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OAUTH_ENCRYPTION_KEY=
# Signs the unsubscribe and email-preference links in subscriber mail.
# UNSUBSCRIBE_SECRET=
# Comma-separated addresses that are never sent mail.
# BLOCKED_EMAILS=
# Inbox that mail sent to the site's own addresses is forwarded to.
# SUPPORT_FORWARD_EMAIL=
# Server-side PostHog capture from Convex; nothing is sent without the key.
# POSTHOG_PROJECT_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Minimum level Convex logs at: debug, info, warn or error
# (default info in production, debug otherwise).
# LOG_LEVEL=
