# Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# CONVEX (Required)
# =============================================================================
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# =============================================================================
# AUTH (Required for authentication)
# =============================================================================
# Google OAuth for auth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_EMAIL_DOMAIN=permtracker.app

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# AI PROVIDERS (Required for chat functionality)
# =============================================================================
# 5 providers with 8 fallback instances for maximum availability
# Get keys from:
# - Google AI Studio: https://aistudio.google.com/
# - OpenRouter: https://openrouter.ai/keys
# - Groq: https://console.groq.com/keys
# - Cerebras: https://cloud.cerebras.ai/
# - Mistral: https://console.mistral.ai/

GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
MISTRAL_API_KEY=your_mistral_api_key

# =============================================================================
# GOOGLE CALENDAR (Required for calendar sync)
# =============================================================================
# Separate from AUTH_GOOGLE_* - different OAuth scopes
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Encryption key for token storage (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# WEB SEARCH (Required for chatbot web search)
# =============================================================================
# Multi-provider fallback: Tavily (primary) -> Brave (fallback)
# Get keys from:
# - Tavily: https://tavily.com/ (1000 free searches/month)
# - Brave: https://brave.com/search/api/ (2000 free searches/month)

TAVILY_API_KEY=your-tavily-api-key
BRAVE_API_KEY=your-brave-api-key

# =============================================================================
# EMAIL (Required for notifications)
# =============================================================================
RESEND_API_KEY=

# =============================================================================
# ANALYTICS — PostHog (Optional, but required for product analytics)
# =============================================================================
# Public client key (browser-exposed) + US cloud host. Get from PostHog →
# Project Settings. Client init lives in src/instrumentation-client.ts and
# sends events via the /ingest reverse proxy (see next.config.ts rewrites).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# ERROR TRACKING — Sentry (Optional)
# =============================================================================
# Client + server DSN (note: sentry.server/edge.config.ts read SENTRY_DSN, the
# unprefixed one). SENTRY_AUTH_TOKEN/ORG/PROJECT are only needed at build time
# for source-map upload. See .env.sentry.example for the full list.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx
SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
