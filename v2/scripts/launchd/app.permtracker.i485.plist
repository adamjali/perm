<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The residential backstop for www.uscis.gov, which 403s GitHub's
       datacenter runners on some days. GitHub tries at 04:00 ET on the 6th
       to the 10th; this Mac tries at 10:30 local time on the same days, so
       GitHub always goes first and either side can carry the month.
       launchd runs a calendar job that fell due while the Mac slept as soon
       as it wakes, so a closed lid delays a run rather than losing it.
       Installed by scripts/launchd/install.sh, which fills in __REPO__. -->
  <key>Label</key><string>app.permtracker.i485</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/v2/scripts/residential_job.sh</string>
    <string>i485</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Day</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>7</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>8</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>9</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>10</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/permtracker/launchd-i485.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/permtracker/launchd-i485.err</string>
  <key>ProcessType</key><string>Background</string>
  <key>ExitTimeOut</key><integer>1500</integer>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
