#!/usr/bin/env python3
"""Every minute: turn Cloudflare's defenses up when people are being turned
away, aim them at whoever is causing it, and turn them back down once it's calm.

WHAT COUNTS AS TROUBLE. Not traffic: a crawler at 300 pages a minute is fine
while there's room. Trouble is people getting the "busy for a moment" page,
from either of two signals:

- five or more people (a browser, not a script) drew the busy page in the last
  10 minutes (the page's counting image, /__pt/busy-seen?k=503); or
- the whole app was full for 3 minutes running: at least 2% of page requests,
  and at least 20, answered 503 in each of the last 3 minutes.

WHAT IT DOES, in order:

1. Finds the source. Over the last 5 minutes of page requests from anything
   Cloudflare hasn't verified as a crawler: a network (ASN) or one exact
   browser label sending 30% or more, and at least 300 requests, is the source.
   A network is preferred, unless it's a consumer ISP or our own hosts, where
   the label is used instead so the rule doesn't land on everyone at home.
   With no such network or label, one part of the site (the first path
   segment, /perm-employers say) drawing 60% or more of the page requests
   turned away, and at least 60, is the source: a scraper on rotating
   addresses and browser labels still asks for one kind of page.
   It adds ONE custom rule (ref pt-autodefend): a managed challenge for that
   source, so a section's rule leaves every other page open. Real browsers
   pass it without a click; scripts don't.
2. Still in trouble 10 minutes later, or no single source: Under Attack Mode
   (every visitor gets Cloudflare's check). Custom rule 2 skips the security
   level, so verified crawlers, AI assistants, link previews, one-click
   unsubscribe and sign-in POSTs, revalidation and the database host never see
   it.
3. Calm for 30 minutes in a row: removes the rule and puts the security level
   back to what it was.

Under Attack Mode runs at most an hour at a time. A scraper that passes
Cloudflare's checks (one did on Oct 2 2026) is not stopped by it, and bursts
often enough that 30 calm minutes may never come, which would leave every real
visitor behind the check for hours for nothing. So after an hour it steps back
to the rule alone and may not return for three hours.

Every change is emailed (at most 8 a day), written to health/repairs.log (the
morning email shows it) and kept in health/defend.json. With no Cloudflare
token (/etc/permtracker/defend.env) or with health/defend.off present it only
WATCHES: it logs what it would do and changes nothing.
"""
from __future__ import annotations

import json
import os
import pathlib
import re
import sys
import time
import urllib.error
import urllib.request
from collections import Counter
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

HEALTH = pathlib.Path(os.environ.get("PT_HEALTH_DIR", "/srv/permtracker/health"))
STATE = HEALTH / "defend.json"
OFF = HEALTH / "defend.off"
REPAIRS = HEALTH / "repairs.log"
DEFEND_LOG = pathlib.Path(os.environ.get("PT_DEFEND_LOG", "/var/log/permtracker-busy/defend.log"))
BUSY_LOG = pathlib.Path(os.environ.get("PT_BUSY_LOG", "/var/log/permtracker-busy/seen.log"))
DEPLOYING = HEALTH / "deploying"   # written by permtracker-deploy while it warms and switches
DEPLOY_GRACE = 1200                # a marker older than this is a deploy that died; ignore it
CONFIG = pathlib.Path(os.environ.get("PT_DEFEND_CONFIG", "/etc/permtracker/defend.env"))
APP_ENV = pathlib.Path("/srv/permtracker/app/env/production.env")
# The mail Worker on Cloudflare (workers/mail/): free mail to the owner, outside
# Resend's 100 a day. OWNER_MAIL_URL and OWNER_MAIL_KEY; Resend when unset or down.
OWNER_MAIL = pathlib.Path("/etc/permtracker/owner-mail.env")
# Resend sits behind Cloudflare, which refuses Python's default User-Agent
# ("Python-urllib/3.x") with HTTP 403 and "error code: 1010". Every alert this
# script sent failed that way until Oct 3 2026; a named agent gets through.
USER_AGENT = "permtracker-defend/1.0 (+https://permtracker.app)"

PEOPLE_BUSY = 5            # people who drew the busy page (owner, Oct 3 2026; was 2) ...
PEOPLE_WINDOW = 600        # ... in this many seconds
FULL_SHARE = 0.02          # a minute is "full" at 2% of page requests answered 503,
FULL_MIN = 20              # and at least 20 of them,
FULL_MINUTES = 3           # for this many minutes running
SOURCE_WINDOW = 300        # look for the source over the last 5 minutes
SOURCE_SHARE = 0.30
SOURCE_MIN = 300
ESCALATE_AFTER = 600       # Under Attack Mode if still in trouble 10 minutes after the rule
CALM_FOR = 1800            # all off after 30 calm minutes
ATTACK_MAX = 3600          # Under Attack Mode at most an hour at a time,
ATTACK_COOLDOWN = 10800    # then not again for three hours
EMAILS_PER_DAY = 8
RULE_REF = "pt-autodefend"
SECTION_SHARE = 0.60       # one part of the site drawing 60% of the page requests turned away,
SECTION_MIN = 60           # and at least 60 of them, is challenged on its own
SECTION_PATH = re.compile(r"/[a-z0-9-]*")
# Never challenged as a section: what isn't a page a person opens. The site's
# own scripts fetch /api, other sites frame /embed (a check can't finish in an
# iframe), and analytics and emailed links can't pass one either.
SECTION_NEVER = {
    "/api", "/ingest", "/embed", "/v1", "/mcp", "/prefs", "/unsubscribe", "/case-alert", "/queue-alert",
    "/bulletin-alert", "/employer-alert", "/firm-claim", "/watched-cases", "/badge", "/open-data", "/sitemaps",
}

# Never challenged as a whole network: our own hosts, and the big consumer and
# mobile ISPs in the US, Canada, India and China, where the visitors are people
# at home. A source on one of these is targeted by its browser label instead.
WHOLE_NETWORK_NEVER = {
    13335, 31898,  # Cloudflare; Oracle (this server)
    7922, 20115, 7018, 701, 22773, 20001, 11351, 11426, 12271, 10796,
    21928, 6167, 22394, 209, 5650, 30036, 6128, 19108,
    577, 812, 6327, 852,
    55836, 45609, 9498, 24560, 4134, 4837, 9808,
}

STATIC = re.compile(r"^/(_next/|images/|og/|lottie/|about/|agency/|favicon|icon-|apple-touch|badge-72|__pt/|sw\.js|manifest)")
NOT_PERSON = re.compile(
    r"bot|crawl|spider|slurp|externalagent|externalhit|fetcher|headless|lighthouse|python|curl|wget|"
    r"httpclient|java/|go-http|node-fetch|axios|okhttp|scrapy|playwright|puppeteer|phantom", re.I)
# nginx pt_defend: $msec $status $http_x_pt_asn $http_x_pt_verified_bot "$request_uri" "$http_user_agent"
# $http_next_router_prefetch (the last field since Oct 20 2026; older lines lack it)
DEFEND_LINE = re.compile(r'^(\d+(?:\.\d+)?) (\d{3}) (\S+) (\S+) "([^"]*)" "(.*)"(?: (\S+))?$')
# A browser running the site's scripts sends analytics beacons; a scraper that
# only fetches pages sends none. A browser label that sends at least this many
# beacons per page it asks for is people, and is never challenged as a label
# (Oct 20 2026: the busiest label was Windows Chrome 155, the current Chrome,
# about half of all real page views, and challenging it landed on readers).
PEOPLE_BEACON_SHARE = 0.05
# nginx pt_busy_seen: $time_iso8601 $status $remote_addr $arg_k "$http_user_agent"
BUSY_LINE = re.compile(r'^(\S+) (\d{3}) (\S+) (\S*) "(.*)"$')


def tail_lines(path: pathlib.Path, max_bytes: int = 16 << 20) -> list[str]:
    """The end of a log (its last 16 MB is several times the 10 minutes read)."""
    try:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read()
    except OSError:
        return []
    lines = data.decode("utf-8", "replace").splitlines()
    return lines[1:] if size > max_bytes else lines


def page_requests(lines: list[str], since: float) -> list[tuple[float, int, int | None, bool, str, str]]:
    """(time, status, asn, verified crawler, user agent, path) for each app page since `since`.

    The path is the one the visitor asked for, without its query: nginx logs
    $request_uri. It logged $uri until Oct 12 2026, which for a turned-away
    request is the busy page's own /503.html, so every alert named /503.html
    as the busiest section and no section could ever be found."""
    out = []
    for ln in lines:
        m = DEFEND_LINE.match(ln)
        if not m:
            continue
        t = float(m.group(1))
        path = m.group(5).split("?", 1)[0]
        # A pre-load is the browser fetching a link before anyone clicks it;
        # nginx refuses those past their own cap, and a refused one costs the
        # reader nothing, so it is neither a page nor a sign the app is full.
        # Analytics beacons go straight to PostHog and are counted apart.
        if t < since or STATIC.match(path) or path.startswith("/ingest") or m.group(7) == "1":
            continue
        asn = int(m.group(3)) if m.group(3).isdigit() else None
        out.append((t, int(m.group(2)), asn, m.group(4) == "true", m.group(6), path))
    return out


def beacons_by_label(lines: list[str], since: float) -> Counter:
    """Analytics beacons (/ingest) per browser label since `since`."""
    out: Counter = Counter()
    for ln in lines:
        m = DEFEND_LINE.match(ln)
        if m and float(m.group(1)) >= since and m.group(5).startswith("/ingest"):
            out[m.group(6)] += 1
    return out


def people_busy(lines: list[str], now: float) -> int:
    """Distinct people (address and browser) who drew the busy page lately."""
    seen = set()
    for ln in lines:
        m = BUSY_LINE.match(ln)
        if not m or m.group(2) != "200" or m.group(4) != "503" or NOT_PERSON.search(m.group(5)):
            continue
        try:
            t = datetime.fromisoformat(m.group(1).replace("Z", "+00:00")).timestamp()
        except ValueError:
            continue
        if t >= now - PEOPLE_WINDOW:
            seen.add((m.group(3), m.group(5)))
    return len(seen)


def full_minutes(reqs, now: float) -> int:
    """How many of the last FULL_MINUTES whole minutes the app was full.

    Crawlers are left out of both counts. nginx answers a crawler past its own
    small cap (a few pages at a time) with the same 503 as a full app, so
    counting them made a minute "full" with no person turned away: on Oct 7
    2026, 12:16 AM EDT, ShapBot, Meta's crawler, AhrefsBot and Applebot drew
    most of 137 such replies in five minutes while the defense counted 0
    people shown the busy page, and it was heading for Under Attack Mode."""
    n = 0
    for k in range(1, FULL_MINUTES + 1):
        lo, hi = now - 60 * k, now - 60 * (k - 1)
        minute = [r for r in reqs if lo <= r[0] < hi and not r[3] and not NOT_PERSON.search(r[4])]
        refused = sum(1 for r in minute if r[1] == 503)
        if refused >= FULL_MIN and refused >= FULL_SHARE * len(minute):
            n += 1
    return n


def section_of(path: str) -> str | None:
    """The part of the site a path is in ("/perm-employers"), or None for a
    path that isn't plainly one (the value lands in a Cloudflare expression)."""
    sec = "/" + path.strip("/").split("/")[0]
    return sec if SECTION_PATH.fullmatch(sec) else None


def find_section(reqs, now: float) -> dict | None:
    """One part of the site drawing most of the page requests turned away.

    Oct 12 2026: three Under Attack episodes in 12 hours came from one scraper
    on about 70,000 addresses and 335 browser labels, so no network or label
    ever reached 30%, while 96% of what it asked for were employer pages.
    Challenging those pages alone leaves the rest of the site open."""
    refused = [r for r in reqs if r[0] >= now - SOURCE_WINDOW and r[1] == 503
               and not r[3] and not NOT_PERSON.search(r[4])]
    if len(refused) < SECTION_MIN:
        return None
    sec, n = Counter(section_of(r[5]) for r in refused).most_common(1)[0]
    if sec is None or sec in SECTION_NEVER or n < SECTION_MIN or n < SECTION_SHARE * len(refused):
        return None
    return {"kind": "section", "value": sec, "share": round(n / len(refused), 2), "requests": n}


def find_source(reqs, now: float, beacons: Counter | None = None) -> dict | None:
    """The network or browser label sending most unverified page requests, or
    failing those, the part of the site most of the turned-away requests were for.
    A label whose browsers run the site's scripts is people, never the source."""
    recent = [r for r in reqs if r[0] >= now - SOURCE_WINDOW and not r[3]]
    if len(recent) < SOURCE_MIN:
        return None
    asn, n_asn = (Counter(r[2] for r in recent if r[2] is not None).most_common(1) or [(None, 0)])[0]
    ua, n_ua = (Counter(r[4] for r in recent if r[4]).most_common(1) or [(None, 0)])[0]
    total = len(recent)
    if asn is not None and asn not in WHOLE_NETWORK_NEVER and n_asn >= SOURCE_MIN and n_asn >= SOURCE_SHARE * total:
        return {"kind": "asn", "value": asn, "share": round(n_asn / total, 2), "requests": n_asn}
    people = beacons is not None and beacons.get(ua, 0) >= PEOPLE_BEACON_SHARE * n_ua
    if ua and not people and n_ua >= SOURCE_MIN and n_ua >= SOURCE_SHARE * total:
        return {"kind": "ua", "value": ua, "share": round(n_ua / total, 2), "requests": n_ua}
    return find_section(reqs, now)


def what_filled(reqs, now: float) -> str:
    """What filled the app, in words, for the alert.

    The defense acts on a full app even when nobody drew the busy page, which
    is what a scraper looks like: it fetches pages and never draws them. An
    alert that said only "0 people shown the busy page" read as a false alarm
    (Oct 4 2026, 2:07 PM EDT: 841 page requests turned away in 3 minutes, from
    about 880 addresses asking once or twice each). Pure.
    """
    recent = [r for r in reqs if r[0] >= now - 60 * FULL_MINUTES]
    refused = [r for r in recent if r[1] == 503]
    if not refused:
        return ""
    sections = Counter("/" + r[5].strip("/").split("/")[0] for r in refused).most_common(3)
    where = ", ".join(f"{p} ({n})" for p, n in sections)
    labels = len({r[4] for r in refused})
    return (f"In the last {FULL_MINUTES} minutes {len(refused):,} of {len(recent):,} page requests were turned away "
            f"with the busy reply, under {labels:,} browser labels, mostly for {where}.")


def lead(people: int, filled: str) -> str:
    """The alert's first sentence: who was turned away, in plain words."""
    if people >= PEOPLE_BUSY:
        head = f"{people} people were shown the busy page in the last 10 minutes."
    else:
        head = ("The app was full minute after minute, and no visitor's browser drew the busy page, which is what a "
                "scraper looks like: it fetches pages and never draws them.")
    return f"{head} {filled}".strip()


def rule_expression(source: dict) -> str:
    if source["kind"] == "asn":
        return f"ip.src.asnum eq {int(source['value'])}"
    if source["kind"] == "section":
        sec = str(source["value"])
        if not SECTION_PATH.fullmatch(sec) or sec in SECTION_NEVER:
            raise ValueError(f"not a section the defense may challenge: {sec!r}")
        if sec == "/":
            return 'http.request.uri.path eq "/"'
        return f'(http.request.uri.path eq "{sec}" or starts_with(http.request.uri.path, "{sec}/"))'

    ua = str(source["value"]).replace("\\", "\\\\").replace('"', '\\"')
    return f'http.user_agent eq "{ua}"'


def describe(source: dict | None) -> str:
    if not source:
        return "no single source"
    if source["kind"] == "section":
        where = "the homepage" if source["value"] == "/" else f"the {source['value']} pages"
        return (f"visitors to {where} ({source['requests']} of the page requests turned away in 5 minutes, "
                f"{int(source['share'] * 100)}%)")
    what = f"network AS{source['value']}" if source["kind"] == "asn" else f"browser label \"{source['value'][:90]}\""
    return f"{what} ({source['requests']} page requests in 5 minutes, {int(source['share'] * 100)}%)"


def decide(state: dict, trouble: bool, source: dict | None, now: float) -> list[tuple[str, dict]]:
    """The actions this minute calls for, given the saved state. Pure."""
    acts: list[tuple[str, dict]] = []
    mode = state.get("mode", "off")
    if trouble:
        state["calmSince"] = None
        if mode == "off":
            if source:
                acts.append(("rule_on", {"source": source}))
            elif now >= float(state.get("attackCooldownUntil") or 0):
                acts.append(("attack_on", {"reason": "no single source"}))
        elif (mode == "rule" and now - float(state.get("since", now)) >= ESCALATE_AFTER
              and now >= float(state.get("attackCooldownUntil") or 0)):
            acts.append(("attack_on", {"reason": "still turning people away 10 minutes after the rule"}))
        elif mode == "attack" and now - float(state.get("since", now)) >= ATTACK_MAX:
            acts.append(("attack_off", {"reason": "an hour of Under Attack Mode did not end it"}))
    elif mode != "off":
        calm = state.get("calmSince") or now
        state["calmSince"] = calm
        if now - float(calm) >= CALM_FOR:
            acts.append(("all_off", {}))
            # The three-hour wait follows EVERY Under Attack episode, not only
            # one that hit the hour cap. On Oct 2 2026 five episodes each ended
            # calmly after 31 to 41 minutes and came straight back, about three
            # hours of every visitor passing Cloudflare's check in six.
            if mode == "attack":
                state["attackCooldownUntil"] = now + ATTACK_COOLDOWN
    return acts


class Cloudflare:
    def __init__(self, token: str, zone: str):
        self.token, self.zone = token, zone

    def call(self, method: str, path: str, body: dict | None = None) -> dict:
        req = urllib.request.Request(
            f"https://api.cloudflare.com/client/v4/zones/{self.zone}{path}",
            data=json.dumps(body).encode() if body is not None else None, method=method,
            headers={"Authorization": f"Bearer {self.token}", "Content-Type": "application/json",
                     "User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=20) as r:
            out = json.load(r)
        if not out.get("success"):
            raise RuntimeError(f"Cloudflare {method} {path}: {out.get('errors')}")
        return out["result"]

    def entrypoint(self) -> dict:
        return self.call("GET", "/rulesets/phases/http_request_firewall_custom/entrypoint")

    def add_rule(self, source: dict) -> None:
        ep = self.entrypoint()
        if any(r.get("ref") == RULE_REF for r in ep.get("rules", [])):
            return
        self.call("POST", f"/rulesets/{ep['id']}/rules", {
            "ref": RULE_REF, "action": "managed_challenge", "enabled": True,
            "expression": rule_expression(source),
            "description": f"AUTO (permtracker-defend): {describe(source)}. Removed by itself after 30 calm minutes.",
        })

    def remove_rule(self) -> None:
        ep = self.entrypoint()
        for r in ep.get("rules", []):
            if r.get("ref") == RULE_REF:
                self.call("DELETE", f"/rulesets/{ep['id']}/rules/{r['id']}")

    def security_level(self) -> str:
        return self.call("GET", "/settings/security_level")["value"]

    def set_security_level(self, value: str) -> None:
        self.call("PATCH", "/settings/security_level", {"value": value})


def read_env(path: pathlib.Path) -> dict:
    out = {}
    try:
        for ln in path.read_text().splitlines():
            if "=" in ln and not ln.lstrip().startswith("#"):
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def note(msg: str) -> None:
    line = f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} defend: {msg}"
    print(line)
    try:
        with REPAIRS.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def email(state: dict, cfg: dict, subject: str, text: str) -> None:
    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    sent = state.setdefault("emails", {})
    if sent.get(day, 0) >= EMAILS_PER_DAY:
        return
    # When it happened, first, as the server alarm's emails do (they had no time at all).
    stamp = datetime.now(ZoneInfo("America/New_York")).strftime("%A %b %-d, %-I:%M %p %Z")
    body = f"At {stamp}.\n\n{text}"
    worker = read_env(OWNER_MAIL)
    if worker.get("OWNER_MAIL_URL") and worker.get("OWNER_MAIL_KEY"):
        req = urllib.request.Request(
            worker["OWNER_MAIL_URL"], method="POST", data=json.dumps({"subject": subject, "text": body}).encode(),
            headers={"x-owner-mail-key": worker["OWNER_MAIL_KEY"], "Content-Type": "application/json",
                     "User-Agent": USER_AGENT})
        try:
            urllib.request.urlopen(req, timeout=15).read()
            sent[day] = sent.get(day, 0) + 1
            state["emails"] = {d: n for d, n in sent.items() if d >= day}
            return
        except (urllib.error.URLError, OSError) as exc:
            print(f"mail Worker failed, using Resend: {exc}")
    key, to = read_env(APP_ENV).get("RESEND_API_KEY"), cfg.get("ALERT_TO")
    if not key or not to:
        return
    req = urllib.request.Request(
        "https://api.resend.com/emails", method="POST",
        data=json.dumps({"from": "PERM Tracker <notifications@permtracker.app>", "to": [to],
                         "subject": subject, "text": body}).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json",
                 "User-Agent": USER_AGENT})
    try:
        urllib.request.urlopen(req, timeout=20).read()
        sent[day] = sent.get(day, 0) + 1
        state["emails"] = {d: n for d, n in sent.items() if d >= day}
    except (urllib.error.URLError, OSError) as exc:
        print(f"email failed: {exc}")


UNDO = ("To undo by hand: Cloudflare, Security, WAF, custom rules: delete the rule whose description "
        "starts AUTO; Security, Settings: set the security level back. To stop this from acting: "
        "touch /srv/permtracker/health/defend.off on the server.")


def deploying_now(now: float) -> bool:
    """A deploy is warming the new copies, so the app being full is our own
    load, not an attack (Oct 3 2026: the warm-up's busy minutes set off Under
    Attack Mode with nobody shown the busy page). A stale marker, from a deploy
    that died before removing it, stops counting after DEPLOY_GRACE."""
    try:
        return now - DEPLOYING.stat().st_mtime < DEPLOY_GRACE
    except OSError:
        return False


PROC = pathlib.Path(os.environ.get("PT_PROC", "/proc"))
CPU_SAMPLE_S = 3


def cpu_ticks() -> dict[str, int]:
    """CPU ticks used so far by the database and by the website copies."""
    out = {"db": 0, "web": 0}
    for d in PROC.iterdir():
        if not d.name.isdigit():
            continue
        try:
            comm = (d / "comm").read_text().strip()
            fields = (d / "stat").read_text().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            continue
        ticks = int(fields[11]) + int(fields[12])      # utime + stime
        if comm == "sqld":
            out["db"] += ticks
        elif comm.startswith("next-server"):
            out["web"] += ticks
    return out


def database_bound(before: dict[str, int], after: dict[str, int]) -> bool:
    """The server, not the traffic, is the bottleneck: over the sample the
    database used more CPU than every website copy together. An attack fills
    the app with page renders; our own load fills it with database work, and a
    browser check in front of visitors helps with only the first. On Oct 3 2026
    at 12:02 PM EDT a history load did exactly this, and Under Attack Mode ran
    for 31 minutes with nobody shown the busy page."""
    db = after["db"] - before["db"]
    web = after["web"] - before["web"]
    return db > web and db > 0


def in_trouble(people: int, full: int) -> bool:
    """People are being turned away: enough of them drew the busy page, or the
    app was full minute after minute. Two people set off Under Attack Mode five
    times on Oct 2 2026, and the busy page itself already tells a person to try
    again in a moment, so the bar is five."""
    return people >= PEOPLE_BUSY or full >= FULL_MINUTES


def reconcile(cf, now: float) -> dict:
    """The state to start from when the saved one can't be read, taken from
    what Cloudflare says now: the automatic rule present means "rule", Under
    Attack Mode on means "attack". Its 30-calm-minute clock starts now.

    Starting from "off" instead (what this did until Oct 10 2026) left Under
    Attack Mode or the rule on with nothing that would ever turn it off, and
    the daily email cap, kept in the same unsaved file, lost its count.
    """
    state: dict = {"mode": "off"}
    has_rule = any(r.get("ref") == RULE_REF for r in cf.entrypoint().get("rules", []))
    attack = cf.security_level() == "under_attack"
    if attack:
        state.update(mode="attack", since=now, restoreLevel="low")
    elif has_rule:
        state.update(mode="rule", since=now)
    if state["mode"] != "off":
        note(f"state file unreadable; Cloudflare says {state['mode']} is on, so the defense resumes from that")
    return state


def main() -> int:
    now = time.time()
    try:
        state = json.loads(STATE.read_text())
        saved = True
    except (OSError, ValueError):
        state = {"mode": "off"}
        saved = False
    defend_lines = tail_lines(DEFEND_LOG)
    reqs = page_requests(defend_lines, now - max(SOURCE_WINDOW, 60 * FULL_MINUTES))
    beacons = beacons_by_label(defend_lines, now - SOURCE_WINDOW)
    people = people_busy(tail_lines(BUSY_LOG, 2 << 20), now)
    deploying = deploying_now(now)
    full = 0 if deploying else full_minutes(reqs, now)
    db_bound = False
    if full >= FULL_MINUTES and people < PEOPLE_BUSY:
        # Only worth the sample when the full app is the whole case.
        before = cpu_ticks()
        time.sleep(CPU_SAMPLE_S)
        db_bound = database_bound(before, cpu_ticks())
        if db_bound:
            full = 0
    trouble = in_trouble(people, full)
    source = find_source(reqs, now, beacons) if trouble else None
    acts = decide(state, trouble, source, now)
    if not trouble:
        state.pop("lastWould", None)

    cfg = read_env(CONFIG)
    live = bool(cfg.get("CF_API_TOKEN") and cfg.get("CF_ZONE_ID")) and not OFF.exists()
    filled = what_filled(reqs, now)
    why = (f"{people} people shown the busy page in 10 minutes, app full {full} of the last {FULL_MINUTES} minutes"
           + (" (a deploy is running, so a full app is not counted)" if deploying else "")
           + (" (the database, not traffic, is using the CPU, so a full app is not counted)" if db_bound else ""))
    cf = Cloudflare(cfg["CF_API_TOKEN"], cfg["CF_ZONE_ID"]) if live else None
    if cf is not None and not saved:
        try:
            state = reconcile(cf, now)
            acts = decide(state, trouble, source, now)
        except Exception as exc:  # noqa: BLE001 - Cloudflare unreadable too: start from off, as before
            note(f"state file unreadable and Cloudflare didn't answer ({exc}); starting from off")
    for act, info in acts:
        if not live:
            # Watching only: say what would have happened once per change of mind.
            key = f"{act}:{describe(info.get('source'))}"
            if state.get("lastWould") != key:
                note(f"would {act.replace('_', ' ')} ({describe(info.get('source'))}; {why}); not live")
                state["lastWould"] = key
            continue
        try:
            if act == "rule_on":
                cf.add_rule(info["source"])
                state.update(mode="rule", since=now, source=info["source"])
                note(f"challenge on for {describe(info['source'])}; {why}")
                email(state, cfg, "PERM Tracker: automatic defense on",
                      f"{lead(people, filled)}\n\nCloudflare now asks {describe(info['source'])} "
                      f"to pass a browser check."
                      + (" Every other page stays open." if info["source"]["kind"] == "section" else "")
                      + f" It turns itself off after 30 calm minutes, and moves to "
                      f"Under Attack Mode if trouble continues for 10.\n\nCounts: {why}.\n\n{UNDO}")
            elif act == "attack_on":
                if state.get("mode") != "attack":
                    level = cf.security_level()
                    if level != "under_attack":
                        state["restoreLevel"] = level
                    cf.set_security_level("under_attack")
                    state.update(mode="attack", since=now)
                    note(f"Under Attack Mode on ({info['reason']}); {why}")
                    email(state, cfg, "PERM Tracker: Under Attack Mode on",
                          f"{lead(people, filled)} "
                          + ("No single network, browser label or part of the site stood out, so a rule for "
                             "one source couldn't help." if info["reason"] == "no single source" else
                             f"A rule for the busiest source didn't end it ({info['reason']}).")
                          + f"\n\nEvery visitor now "
                          f"passes Cloudflare's check first, except verified crawlers, AI assistants, link "
                          f"previews, unsubscribe and sign-in, which skip it. It turns itself off after 30 calm "
                          f"minutes.\n\nCounts: {why}.\n\n{UNDO}")
            elif act == "attack_off":
                cf.set_security_level(state.get("restoreLevel") or "low")
                state.update(mode="rule", since=now, attackCooldownUntil=now + ATTACK_COOLDOWN)
                note(f"Under Attack Mode off after an hour ({info['reason']}); not again for 3 hours; {why}")
                email(state, cfg, "PERM Tracker: Under Attack Mode off after an hour",
                      f"An hour of Under Attack Mode did not end the trouble ({why}), so it is off again and "
                      f"may not come back for three hours: whatever is causing it is passing Cloudflare's check. "
                      f"The rule for the source stays until 30 calm minutes.\n\n{UNDO}")
            elif act == "all_off":
                cf.remove_rule()
                if state.get("mode") == "attack":
                    cf.set_security_level(state.get("restoreLevel") or "low")
                lasted = int((now - float(state.get("since", now))) / 60)
                waits = state.get("mode") == "attack"
                note(f"all off after 30 calm minutes (was {state.get('mode')} for {lasted} min)"
                     + ("; Under Attack Mode not again for 3 hours" if waits else ""))
                email(state, cfg, "PERM Tracker: automatic defense off",
                      f"Thirty calm minutes, so the automatic rule is removed and the security level is back to "
                      f"{state.get('restoreLevel') or 'low'}. It was on for {lasted} minutes.")
                state.update(mode="off", since=None, source=None, calmSince=None, restoreLevel=None)
        except Exception as exc:  # noqa: BLE001 - one failed call must not wedge the state
            note(f"{act} failed: {exc}")
    state["checkedAt"] = int(now)
    state["last"] = {"people": people, "fullMinutes": full, "pageRequests": len(reqs), "live": live}
    # A full disk refuses this file (Oct 10 2026: the defense failed every
    # minute for three hours). The actions above already happened; losing the
    # state means the next run starts from what Cloudflare says now (reconcile).
    try:
        HEALTH.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state))
        tmp.replace(STATE)
    except OSError as exc:
        print(f"state not saved: {exc}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
