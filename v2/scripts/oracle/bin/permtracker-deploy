#!/bin/bash
# The ONLY thing GitHub's deploy key may run on this server.
#   deploy <release-id>   read a .tar.zst release on stdin, start it on the
#                         idle copy, health-check it, then switch traffic
#   rollback              switch traffic back to the other copy
#   second                start the live slot's second copy and add it
#   status                print which copy serves and what each runs
#   prune-releases        delete old releases no slot runs (the deploy starts
#                         it in the background after the switch)
#   convex-backup <stamp> store a SEALED Convex export read on stdin (the
#                         nightly workflow encrypts it on GitHub with the
#                         backup key's public half), then copy it to R2
set -euo pipefail
A=/srv/permtracker/app
cmd="${1:-status}"; set -- $cmd
action="${1:-status}"; rel="${2:-}"
# Each slot runs its release TWICE, one copy per CPU (Oct 2 2026): Node builds
# pages on one core, so one copy saturated at two or three times normal
# traffic while the second core idled, and a scraper burst turned people away.
# The second copy ("blue2", "green2") runs its own copy of the release folder
# (<release>.w2), so the two never write the same cache file, and nginx sends
# each page to the same copy every time (hash in the upstream file), so a page
# is built and cached once. After a switch the old slot keeps its FIRST copy
# running for an instant rollback; its second copy stops and frees its memory.
port_of(){ case "$1" in blue) echo 3001 ;; green) echo 3002 ;; blue2) echo 3011 ;; green2) echo 3012 ;; esac; }
other_of(){ [ "$1" = blue ] && echo green || echo blue; }
ensure_env(){ # $1 copy: blue2/green2 need a PORT file like blue's and green's
  local f="$A/env/$1.env"
  [ -f "$f" ] || { echo "PORT=$(port_of "$1")" > "$f"; chown root:permtracker "$f"; chmod 640 "$f"; }
}
active=$(cat $A/active)
log(){ echo "[deploy $(date -u +%H:%M:%S)] $*"; logger -t permtracker-deploy "$*"; }

reload_nginx(){
  # A reload nginx REFUSES keeps the old rules running while `systemctl reload`
  # still exits 0: measured Sep 29 2026, when a rate-limit zone's key changed
  # ("limit_req ... uses the ... key while previously it used ..." in
  # error.log) and `nginx -t` had passed. So a reload counts only when new
  # worker processes appear.
  local before; before=$(pgrep -d, -f "nginx: worker process" || true)
  nginx -t -q
  systemctl reload nginx
  for _ in $(seq 1 40); do
    for p in $(pgrep -f "nginx: worker process"); do
      case ",$before," in *",$p,"*) ;; *) return 0 ;; esac
    done
    sleep 0.25
  done
  log "nginx REFUSED the reload (grep emerg /var/log/nginx/error.log); its old rules are still running"
  return 1
}
switch_to(){ # $1 slot
  # Both copies when the second one runs; the first alone otherwise. The hash
  # key is the path and query without Next's `_rsc` token (nginx config), so a
  # page and its data request always reach the same copy. w1/w2 are the copies
  # one by one: refresh calls go to w1 and are mirrored to w2.
  # A copy is set aside only after 3 failures, for 5 s (nginx's default is 1
  # failure for 10 s): on Oct 2 2026 single resets marked both copies down at
  # once and every request in those seconds got a 502 ("no live upstreams").
  local p1 p2 opts="max_fails=3 fail_timeout=5s"
  p1=$(port_of "$1"); p2=$p1
  if systemctl is-active --quiet "permtracker-web@${1}2"; then p2=$(port_of "${1}2"); fi
  if [ "$p2" != "$p1" ]; then
    printf 'hash "$uri?$pt_args_no_rsc" consistent;\nserver 127.0.0.1:%s %s;\nserver 127.0.0.1:%s %s;\n' "$p1" "$opts" "$p2" "$opts" \
      > /etc/nginx/permtracker-active-upstream.conf
  else
    echo "server 127.0.0.1:$p1 $opts;" > /etc/nginx/permtracker-active-upstream.conf
  fi
  echo "server 127.0.0.1:$p1 $opts;" > /etc/nginx/permtracker-active-w1.conf
  echo "server 127.0.0.1:$p2 $opts;" > /etc/nginx/permtracker-active-w2.conf
  # $A/live points at the serving release: nginx serves its public/ images
  # straight from disk. Renamed into place, so it is never missing mid-switch.
  ln -sfn "$(readlink -f "$A/slots/$1")" "$A/live.next" && mv -T "$A/live.next" "$A/live"
  # Traffic is recorded as moved only once nginx has taken the new upstream.
  reload_nginx
  echo "$1" > $A/active
  log "traffic now on $1 ($(readlink $A/slots/$1 | xargs basename)), ports $p1$([ "$p2" != "$p1" ] && echo " and $p2")"
}
order_paths(){ # $1 the release's warm-first.txt; the usual warm-up paths on stdin
  # The pages the push changed go first ("page <path>" lines), then the
  # sitemap pages under a changed family ("prefix <path>/"), then the rest in
  # their usual order, each once. Those are the pages the deploy tells
  # Cloudflare to forget after the switch, so their next visitors are the ones
  # who reach the server; warmed last, the 4-minute budget could run out first.
  local all exact="" prefixes=""
  all=$(cat)
  if [ -f "$1" ]; then
    exact=$(awk '$1 == "page" && $2 ~ /^\// { print $2 }' "$1")
    prefixes=$(awk '$1 == "prefix" && $2 ~ /^\/.+\/$/ { print $2 }' "$1")
  fi
  {
    printf '%s\n' "$exact"
    if [ -n "$prefixes" ]; then
      printf '%s\n' "$all" | PFX="$prefixes" awk 'BEGIN { n = split(ENVIRON["PFX"], p, "\n") }
        { for (i = 1; i <= n; i++) if (p[i] != "" && index($0, p[i]) == 1) { print; next } }'
    fi
    printf '%s\n' "$all"
  } | awk 'NF && !seen[$0]++'
}
warm(){ # $1 port, $2 the release folder (for its warm-first.txt)
  # Render the core pages on the NEW copy before it takes traffic. Each release
  # starts with an empty page cache, so without this the first visitor to every
  # page after a deploy waited for a cold render: 1 to 4.5 s, 152 of 855 pages
  # over a second in our Oct 1 2026 audit. The pages come from the sitemap the
  # copy itself serves, two at a time, for at most 4 minutes; nothing here can
  # fail or block a deploy (the old copy keeps serving until the switch).
  # Core pages first (475, about 47 s measured), then the 300 busiest
  # employers (employer-1.xml lists them by volume).
  #
  # Each sitemap is fetched WHOLE and cut with `sed -n`, which reads all of its
  # input. The first version cut with `head -300`: under this script's
  # `set -euo pipefail`, head closing the pipe killed curl with SIGPIPE (141),
  # the path list "failed", and warm returned before logging, so the first two
  # deploys with it (Oct 1 2026) warmed nothing and said nothing.
  local port=$1 first="${2:-}/warm-first.txt" core emp paths changed=0
  core=$(curl -fsS --max-time 30 -H "Host: permtracker.app" "http://127.0.0.1:$port/sitemaps/pages.xml" || true)
  emp=$(curl -fsS --max-time 30 -H "Host: permtracker.app" "http://127.0.0.1:$port/sitemaps/employer-1.xml" || true)
  paths=$( { printf '%s\n' "$core" | grep -o '<loc>[^<]*</loc>' || true
             printf '%s\n' "$emp" | grep -o '<loc>[^<]*</loc>' | sed -n '1,300p' || true; } \
    | sed -e 's#<loc>https://permtracker.app##' -e 's#</loc>##' | grep -v '^$' || true)
  paths=$(printf '%s\n' "$paths" | order_paths "$first" || true)
  if [ -z "$paths" ]; then log "warm-up skipped: the new copy served no sitemap paths"; return 0; fi
  [ -f "$first" ] && changed=$(grep -c '^page \|^prefix ' "$first" || true)
  printf '%s\n' "$paths" | timeout 240 xargs -P 2 -I{} \
    curl -s -o /dev/null --max-time 30 -H "Host: permtracker.app" "http://127.0.0.1:$port{}" || true
  log "warmed up to $(printf '%s\n' "$paths" | wc -l) pages on the new copy, the push's $changed changed pages and families first (4-minute budget)"
}
healthy(){ # $1 port
  for i in $(seq 1 90); do
    if curl -fsS -o /dev/null --max-time 5 "http://127.0.0.1:$1/api/health" \
       && curl -fsS -o /dev/null --max-time 60 -H "Host: permtracker.app" "http://127.0.0.1:$1/perm-queue"; then return 0; fi
    sleep 2
  done; return 1
}

case "$action" in
  status)
    echo "active: $active"
    for s in blue blue2 green green2; do echo "$s: $(readlink $A/slots/$s 2>/dev/null | xargs -r basename) $(systemctl is-active permtracker-web@$s)"; done ;;
  second)
    # Start the live slot's second copy (from its own .w2 folder, made here if
    # missing) and put it into traffic: the first time after Oct 2 2026, and
    # by hand whenever the live site is running on one copy.
    live_rel=$(readlink -f "$A/slots/$active")
    [ -d "$live_rel.w2" ] || { log "copying $(basename "$live_rel") for the second copy"; ionice -c3 nice cp -a "$live_rel" "$live_rel.w2"; chown -R permtracker:permtracker "$live_rel.w2"; }
    ln -sfn "$live_rel.w2" "$A/slots/${active}2"
    ensure_env "${active}2"
    systemctl enable -q "permtracker-web@${active}2"; systemctl restart "permtracker-web@${active}2"
    healthy "$(port_of "${active}2")" || { log "second copy of $active failed its health check; staying on one"; systemctl stop "permtracker-web@${active}2"; exit 4; }
    switch_to "$active" ;;
  rollback)
    to=$(other_of "$active")
    [ -e "$A/slots/$to" ] || { log "no other copy to roll back to"; exit 1; }
    healthy "$(port_of "$to")" || { log "other copy is not healthy; staying on $active"; exit 1; }
    switch_to "$to"                       # instant, on the copy that kept running
    if [ -e "$A/slots/${to}2" ]; then     # then its second copy joins
      ensure_env "${to}2"; systemctl restart "permtracker-web@${to}2"
      healthy "$(port_of "${to}2")" && switch_to "$to" || log "second copy of $to did not start; serving on one"
    fi
    systemctl stop "permtracker-web@${active}2" 2>/dev/null || true ;;
  deploy)
    [[ "$rel" =~ ^[0-9a-f]{7,40}(-[0-9]{1,6})?$ ]] || { log "bad release id"; exit 2; }
    # A release a slot runs from is never replaced. Oct 8 2026, 2:19 PM EDT: a
    # second run on the same commit arrived under the live release's name, and
    # the `rm -rf` below deleted most of the folder the live site was serving
    # from (31 errors on files it had removed, until a rollback 2 minutes
    # later). The workflow now names each run's release uniquely; this is the
    # guard that holds whatever name arrives.
    for s in blue blue2 green green2; do
      in_use=$(readlink -f "$A/slots/$s" 2>/dev/null || true)
      if [ -n "$in_use" ] && { [ "$in_use" = "$(readlink -f "$A/releases")/$rel" ] || [ "$in_use" = "$(readlink -f "$A/releases")/$rel.w2" ]; }; then
        log "release $rel is what $s runs; refusing to replace it (each deploy needs its own release id)"; exit 5
      fi
    done
    idle=$(other_of "$active")
    tmp=$A/incoming/$rel.tar.zst
    cat > "$tmp"
    log "received $(stat -c %s "$tmp") bytes for $rel"
    rm -rf "$A/releases/$rel"; install -d -o permtracker -g permtracker "$A/releases/$rel"
    tar --zstd -xf "$tmp" -C "$A/releases/$rel"; rm -f "$tmp"
    [ -f "$A/releases/$rel/server.js" ] || { log "release has no server.js"; exit 3; }
    chown -R permtracker:permtracker "$A/releases/$rel"
    cp -a --no-clobber "$A/releases/$rel/.next/static/." "$A/shared/_next/static/"
    # The second copy's own folder, copied while it holds only the build.
    rm -rf "$A/releases/$rel.w2"; cp -a "$A/releases/$rel" "$A/releases/$rel.w2"
    ln -sfn "$A/releases/$rel" "$A/slots/$idle"
    ln -sfn "$A/releases/$rel.w2" "$A/slots/${idle}2"
    ensure_env "${idle}2"
    for w in "$idle" "${idle}2"; do systemctl enable -q "permtracker-web@$w"; systemctl restart "permtracker-web@$w"; done
    for w in "$idle" "${idle}2"; do
      if ! healthy "$(port_of "$w")"; then
        log "NEW RELEASE FAILED its health check on $w; traffic stays on $active"
        journalctl -u "permtracker-web@$w" -n 30 --no-pager | tail -30
        systemctl stop "permtracker-web@${idle}2" || true
        exit 4
      fi
    done
    # Each copy builds the core pages for itself, side by side on the two CPUs,
    # at a tenth of the live copies' CPU weight (20 against 200) so the
    # visitors on the live copies come first. Oct 3 2026: at equal weight the
    # warm-up starved the live copies, 64 page requests a minute got the busy
    # page, and the automatic defense read that as an attack and turned on
    # Under Attack Mode. The marker tells the defense a deploy is running, so
    # its own load is never mistaken for one (people shown busy still count).
    date +%s > /srv/permtracker/health/deploying
    trap 'rm -f /srv/permtracker/health/deploying' EXIT
    for w in "$idle" "${idle}2"; do systemctl set-property --runtime "permtracker-web@$w" CPUWeight=20; done
    warm "$(port_of "$idle")" "$A/releases/$rel" & warm "$(port_of "${idle}2")" "$A/releases/$rel.w2" & wait || true
    for w in "$idle" "${idle}2"; do systemctl set-property --runtime "permtracker-web@$w" CPUWeight=200; done
    switch_to "$idle"
    # The previous release keeps its first copy running (instant rollback); its
    # second copy stops.
    systemctl stop "permtracker-web@${active}2" 2>/dev/null || true
    # Old releases go in the background: traffic has already moved, and on a
    # busy server deleting a release folder (its node_modules and page cache)
    # took 7 minutes after the switch (Oct 8 2026, 2:50 to 2:57 PM EDT), all of
    # it counted as deploy time while the site was already live.
    systemd-run --quiet --no-block --collect --unit="permtracker-release-prune-$(date +%s)" \
      -p Nice=15 -p IOSchedulingClass=idle "$(readlink -f "$0")" prune-releases \
      || "$(readlink -f "$0")" prune-releases
    log "deployed $rel" ;;
  prune-releases)
    # Keep the ten newest releases and every one a slot runs from; drop build
    # files no release has served for three weeks. One at a time.
    exec 9>"$A/.release-prune.lock"
    flock -n 9 || exit 0
    # A slot with no link yet is skipped (under pipefail its failed readlink
    # would otherwise end the prune before it deleted anything).
    keep=$(for s in blue blue2 green green2; do readlink "$A/slots/$s" 2>/dev/null | xargs -r basename || true; done)
    ls -1t "$A/releases" | tail -n +11 | while read -r r; do echo "$keep" | grep -qx "$r" || rm -rf "$A/releases/$r"; done
    find "$A/shared/_next/static" -type f -mtime +21 -delete 2>/dev/null || true
    log "old releases pruned" ;;
  convex-backup)
    # Only ciphertext is accepted: a CMS file (DER, first byte 0x30) under
    # 2 GB. The plaintext never touches this machine or R2.
    [[ "$rel" =~ ^[0-9]{8}-[0-9]{4}$ ]] || { log "bad backup stamp"; exit 2; }
    B=/srv/permtracker/backups; f="$B/convex-$rel.zip.cms"
    head -c 2147483648 > "$f.part"
    [ "$(stat -c %s "$f.part")" -gt 1000 ] && [ "$(od -An -tx1 -N1 "$f.part" | tr -d ' ')" = "30" ] \
      || { log "convex backup: not a sealed file"; rm -f "$f.part"; exit 3; }
    mv "$f.part" "$f"; chown permtracker:permtracker "$f"; chmod 600 "$f"
    ls -1t "$B"/convex-*.zip.cms | tail -n +8 | xargs -r rm -f
    # shellcheck disable=SC1091
    . /usr/local/lib/permtracker/r2-env
    name=$(basename "$f"); size=$(stat -c %s "$f")
    rclone copyto "$f" "r2:permtracker-backups/convex/$name" --s3-no-head --retries 3 --low-level-retries 10 -q
    remote=$(rclone lsjson "r2:permtracker-backups/convex/$name" | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r[0]["Size"] if r else -1)')
    [ "$remote" = "$size" ] || { log "convex backup: uploaded size $remote does not match $size"; exit 4; }
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$size" "$name" > "$B/CONVEX_OK"; chown permtracker:permtracker "$B/CONVEX_OK"
    log "convex backup $name ($size bytes, sealed) stored and in R2"
    # Older copies go only now, after this one landed (permtracker-r2-prune).
    log "$(/usr/local/bin/permtracker-r2-prune convex "$name" 2>&1 | tail -1)" || true ;;
  *) log "unknown action"; exit 2 ;;
esac
