#!/bin/bash
# permtracker-cron <job>: calls the site's own cron route, exactly as Vercel's
# cron did (GET with Authorization: Bearer CRON_SECRET).
set -euo pipefail
job="$1"
case "$job" in
  dispatch-*) path="/api/cron/dispatch/${job#dispatch-}" ;;
  prune-uscis|scorecard) path="/api/cron/$job" ;;
  *) echo "unknown job $job"; exit 2 ;;
esac
out=$(mktemp)
code=$(curl -sS -o "$out" -w '%{http_code}' --max-time 300 \
  -H "Authorization: Bearer $(cat /srv/permtracker/secrets/cron_secret)" \
  -H "Host: permtracker.app" -A "permtracker-cron/1.0" "http://127.0.0.1:8081$path") || code=000
echo "$job -> HTTP $code: $(head -c 400 "$out")"; rm -f "$out"
[[ "$code" =~ ^2 ]]
