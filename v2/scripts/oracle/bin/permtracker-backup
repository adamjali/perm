#!/bin/bash
# Nightly logical backup of the database: a full SQL dump (read-only token),
# zstd-compressed, checked to end in COMMIT, newest 7 kept here. LAST_OK is
# what the daily report reads.
#
# Then the same file goes off the machine, to Cloudflare R2 (bucket
# permtracker-backups, Standard class, the free tier): a copy that survives
# losing this server. The bucket locks each copy for 7 days, so even a stolen
# key cannot erase the last week, and older copies are removed only after a new
# one has landed and checked out (permtracker-r2-prune: the newest 15 and the
# first of each of the 3 newest months stay), so a server that stops uploading
# never loses its last copies. Until Oct 5 2026 the bucket deleted every copy
# after 15 days, which would have emptied it 15 days after losing this
# server. The upload is
# checked by size against the local file; OFFSITE_OK records it, and the daily
# report fails when it goes stale. No key in /etc/permtracker/r2.env means no
# upload, and the report says so rather than passing quietly.
set -euo pipefail
B=/srv/permtracker/backups; f="$B/db-$(date -u +%Y%m%d-%H%M).sql.zst"; tmp="$f.part"
curl -sS --fail --max-time 3600 -H "Authorization: Bearer $(cat /srv/permtracker/secrets/db_ro.jwt)" \
  http://127.0.0.1:8080/dump | zstd -q -T2 -10 -o "$tmp"
zstd -dc "$tmp" | tail -c 200 | grep -q "COMMIT;" || { echo "dump incomplete; kept nothing"; rm -f "$tmp"; exit 1; }
mv "$tmp" "$f"
ls -1t "$B"/db-*.sql.zst | tail -n +8 | xargs -r rm -f
printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$(stat -c %s "$f")" "$(basename "$f")" > "$B/LAST_OK"
echo "backup ok: $(basename "$f") $(du -h "$f" | cut -f1)"

# ---- the H-1B LCA filings' own database (since Oct 19 2026) -----------------
# It changes about once a month, with DOL's LCA file, so it's dumped only when it
# changed: any write moves its data file or grows its replication log, so their
# sizes and the data file's time make the signature. LCA_OK records the copy and
# the signature it was taken at; the health report says when they differ.
L=/srv/permtracker/db-lca/data.sqld/dbs/default
lca_file=""; lca_sig=""
if systemctl is-enabled --quiet permtracker-db-lca 2>/dev/null && [ -f "$L/data" ]; then
  lca_sig="$(stat -c %s:%Y "$L/data"):$(stat -c %s "$L/wallog" 2>/dev/null || echo 0)"
  if [ "$lca_sig" != "$(cut -d' ' -f4 "$B/LCA_OK" 2>/dev/null || true)" ]; then
    lca_file="$B/lca-$(date -u +%Y%m%d-%H%M).sql.zst"
    curl -sS --fail --max-time 3600 -H "Authorization: Bearer $(cat /srv/permtracker/secrets/db_ro.jwt)" \
      http://127.0.0.1:8082/dump | zstd -q -T2 -10 -o "$lca_file.part"
    zstd -dc "$lca_file.part" | tail -c 200 | grep -q "COMMIT;" || { echo "lca dump incomplete; kept nothing"; rm -f "$lca_file.part"; exit 1; }
    mv "$lca_file.part" "$lca_file"
    ls -1t "$B"/lca-*.sql.zst | tail -n +3 | xargs -r rm -f
    echo "lca backup ok: $(basename "$lca_file") $(du -h "$lca_file" | cut -f1)"
  else
    echo "lca backup: unchanged since $(cut -d' ' -f3 "$B/LCA_OK")"
  fi
fi

# ---- off-site copy ----------------------------------------------------------
[ -r /etc/permtracker/r2.env ] || { echo "off-site: no R2 key on this server; not uploaded"; exit 0; }
# shellcheck disable=SC1091
. /usr/local/lib/permtracker/r2-env
name=$(basename "$f"); size=$(stat -c %s "$f")
# --s3-no-head: rclone 1.60 re-reads each upload by version id, which R2 answers
# 501 (measured Sep 29 2026: every first attempt "failed" after the object had
# landed). The size check below is the integrity check instead.
rclone copyto "$f" "r2:permtracker-backups/db/$name" --s3-no-head --s3-chunk-size 16M --retries 3 --low-level-retries 10 -q
remote=$(rclone lsjson "r2:permtracker-backups/db/$name" | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r[0]["Size"] if r else -1)')
[ "$remote" = "$size" ] || { echo "off-site: uploaded size $remote does not match $size"; exit 1; }
printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$size" "$name" > "$B/OFFSITE_OK"
echo "off-site ok: $name ($size bytes) in R2"
# Only now, with a newer copy in place, may older ones go.
/usr/local/bin/permtracker-r2-prune db "$name" || true
if [ -n "$lca_file" ]; then
  lname=$(basename "$lca_file"); lsize=$(stat -c %s "$lca_file")
  rclone copyto "$lca_file" "r2:permtracker-backups/lca/$lname" --s3-no-head --s3-chunk-size 16M --retries 3 --low-level-retries 10 -q
  lremote=$(rclone lsjson "r2:permtracker-backups/lca/$lname" | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r[0]["Size"] if r else -1)')
  [ "$lremote" = "$lsize" ] || { echo "off-site: lca uploaded size $lremote does not match $lsize"; exit 1; }
  printf '%s %s %s %s\n' "$(date -u +%FT%TZ)" "$lsize" "$lname" "$lca_sig" > "$B/LCA_OK"
  echo "off-site ok: $lname ($lsize bytes) in R2"
  /usr/local/bin/permtracker-r2-prune lca "$lname" || true
fi
# The whole bucket, against R2's free 10 GB: the report warns long before a charge.
rclone size r2:permtracker-backups --json | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r["count"], r["bytes"])' > "$B/OFFSITE_SIZE" || true
