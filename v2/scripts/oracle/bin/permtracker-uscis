#!/bin/bash
# permtracker-uscis <i485|i140|quarterly|h1b-hub|sevp|seasonal-jobs|reference|visa-issuances|backtests|h2b-groups|policy-watch|flag-notice|chat-models|firm-programs|whd|osha|posted-times|sam|taa|ppp|warn-archive|bulletin-tables <file> <YYYY-MM>|iv-tool <file|archive>|state-page <nvc|wait-times|news> <file>|state-page issuances <file> <YYYY-MM> <fsc|post>|state-page niv <file> <YYYY-MM>|state-page refusals <file> [<YYYY>]|niv-archive|embassy-notices <file>|browser-check <name> [note]>: the USCIS fetches that ran on the
# owner's Mac until Sep 28 2026, moved here because www.uscis.gov answers this server.
# Same scripts, same failure recording.
set -uo pipefail
job="$1"; R=/srv/permtracker/repo; V2=$R/v2
git -C "$R" fetch -q origin main && git -C "$R" reset -q --hard origin/main
set -a; . /srv/permtracker/app/env/uscis.env; set +a
cd "$V2"
fail(){ python3 scripts/record_ingest_failure.py --script "$1" --note "oracle timer ($job): $2" || echo "could not record the failure row"; }
# A clean run writes its own ok row: the failure recorder refuses "ok" on
# purpose, and the I-140 script records nothing when it succeeds, so without
# this one failed run kept the health check red for its whole window.
ok(){ python3 -c 'import sys; sys.path.insert(0, "scripts"); from lib_db import Database, record_run; record_run(Database(), sys.argv[1], status="ok", note=sys.argv[2])' "$1" "oracle timer ($job): $2" || echo "could not record the ok row"; }
rc=0
# A reader that asks the site to rebuild its pages (lib_policy_feed.expire_policy_page and its siblings) reads
# these two; without them it takes the run for a local one and asks nothing, silently. nginx sends the call to
# both web copies. The secret is the site's own, read from its env file and never printed.
site_refresh_env(){
  export REVALIDATE_BASE=http://127.0.0.1:8081
  REVALIDATE_SECRET="$(sed -n 's/^REVALIDATE_SECRET=//p' /srv/permtracker/app/env/production.env | head -1)"
  export REVALIDATE_SECRET
}
case "$job" in
  i485)
    python3 scripts/ingest_i485_inventory.py || { rc=1; fail ingest_i485_inventory.py "ingest exited non-zero"; }
    # Older months, from the Internet Archive's copies of USCIS's files (Oct 28 2026). It loads only
    # months not held and names any the Archive won't serve in its own run row, so a busy Archive costs
    # a month's wait, never this job's status.
    timeout 30m python3 scripts/ingest_i485_inventory.py --archive || true ;;
  # Layoff notices from the four states read only through the Internet Archive (Louisiana, New Mexico,
  # Missouri, Nevada; Nov 1 2026). The Archive throttles GitHub's shared runners (HTTP 429 on every daily run
  # from Oct 25) and answers this server, so these four are read here and GitHub's run skips them. A state the
  # Archive refuses that day is a warning in the run row and its own freshness row is the alarm; only a parse
  # that broke fails the unit.
  warn-archive)
    timeout 40m nice -n 10 python3 scripts/ingest_warn.py --runner server || { rc=1; fail "ingest_warn.py:server" "exited non-zero or ran past 40m"; } ;;
  # DOL's own notice on FLAG (a maintenance window), read every 15 minutes so
  # the site can say why statuses are late (Oct 27 2026). It writes its own run row.
  # A FLAG that doesn't answer is a "partial" run row and exit 0 (the script
  # asks twice, 2 minutes at most); a non-zero exit or the limit is a defect.
  flag-notice) timeout 3m python3 scripts/ingest_flag_notice.py || { rc=1; fail ingest_flag_notice.py "exited non-zero or ran past 3m"; } ;;
  # Every AI model the chat and summarizer use, asked once a day (Oct 29 2026): free models retire and get
  # refused without notice. It reads the four keys from the app's own env file by name and writes its own run
  # row; it exits non-zero only when no chat model answered, which the alarm emails.
  chat-models) timeout 8m python3 scripts/check_chat_models.py || { rc=1; fail check_chat_models.py "no chat model answered, or the check couldn't run"; } ;;
  # Each law firm's H-1B, wage-request and seasonal lines, worked out once for every firm page (Oct 31 2026): read
  # live, one big firm's page build took 21 s on the LCA database. Here, with no tunnel, every firm takes under a
  # minute. It runs after the 4:10 AM sweep has rebuilt the firm map, and writes its own run row.
  firm-programs) timeout 15m nice -n 5 python3 scripts/build_firm_programs.py || { rc=1; fail build_firm_programs.py "exited non-zero or ran past 15m"; } ;;
  # DOL's Wage and Hour cases (Oct 31 2026): one 200 MB file from data.dol.gov, which answers the server where
  # www.dol.gov doesn't. DOL updates it quarterly; read weekly, and a week with nothing new writes nothing.
  # The employer pages whose cases moved are rebuilt through nginx, which sends the call to both web copies.
  whd)
    site_refresh_env
    timeout 30m nice -n 10 python3 scripts/ingest_whd.py || { rc=1; fail ingest_whd.py "exited non-zero or ran past 30m"; } ;;
  # OSHA's inspections of PERM sponsors (Oct 31 2026): two files from data.dol.gov, 1.5 and 2.3 GB, stored
  # uncompressed. They go to /var/tmp on disk (ingest_osha.py), since /tmp here is memory. OSHA updates daily; read
  # weekly, and a week with nothing new writes nothing. Pages whose inspections moved rebuild through nginx.
  osha)
    site_refresh_env
    timeout 60m nice -n 10 python3 scripts/ingest_osha.py || { rc=1; fail ingest_osha.py "exited non-zero or ran past 60m"; } ;;
  # USCIS's processing-times page as posted, every day since March 2022 (Oct 31 2026): the daily copies an
  # open-source project publishes on GitHub (ingest_uscis_posted_times.py says why and how). Read daily; a day the
  # project published nothing new writes nothing. The two pages that print the figures rebuild through nginx.
  # A visa bulletin copied out of a person's browser (Nov 3 2026): since Nov 2 State sends every
  # adoption.state.gov path to travel.state.gov, which refuses scripts, so the owner's Chrome reads the
  # bulletin's tables and hands their text here. Run by hand with the file and month:
  #   sudo -u permtracker permtracker-uscis bulletin-tables /tmp/bulletin.txt 2026-12
  # Same parser and checks as every route; the bulletin pages refresh through nginx (both web copies).
  bulletin-tables)
    f="${2:-}"; m="${3:-}"
    if [ -z "$f" ] || [ -z "$m" ]; then echo "usage: permtracker-uscis bulletin-tables <file> <YYYY-MM>"; exit 2; fi
    if python3 scripts/ingest_visa_bulletin.py --from-tables "$f" --month "$m"; then
      REVALIDATE_SECRET="$(sed -n 's/^REVALIDATE_SECRET=//p' /srv/permtracker/app/env/production.env | head -1)"
      [ -n "$REVALIDATE_SECRET" ] && curl -s -m 60 -o /dev/null -w "refresh %{http_code}\n" -X POST \
        -H "Host: permtracker.app" -H "x-revalidate-secret: $REVALIDATE_SECRET" \
        http://127.0.0.1:8081/api/revalidate-bulletin || true
    else
      rc=1; fail ingest_visa_bulletin.py "the $m bulletin copied from a browser was refused"
    fi ;;
  # State's IV Scheduling Status Tool copied out of a person's browser (Nov 3 2026), for the bulletin's reason:
  # travel.state.gov refuses scripts. The table's text (or the saved page) goes in a file, read monthly:
  #   sudo -u permtracker permtracker-uscis iv-tool /tmp/iv-tool.txt
  # "iv-tool archive" loads the Internet Archive's older copies (they stop in mid-July 2026). Same parser and
  # checks either way; the consulate pages refresh through nginx (both web copies).
  iv-tool)
    f="${2:-}"
    if [ -z "$f" ]; then echo "usage: permtracker-uscis iv-tool <file|archive>"; exit 2; fi
    if [ "$f" = archive ]; then args=(--archive); else args=(--from-file "$f"); fi
    if timeout 30m python3 scripts/ingest_iv_scheduling.py "${args[@]}"; then
      REVALIDATE_SECRET="$(sed -n 's/^REVALIDATE_SECRET=//p' /srv/permtracker/app/env/production.env | head -1)"
      [ -n "$REVALIDATE_SECRET" ] && curl -s -m 60 -o /dev/null -w "refresh %{http_code}\n" -X POST \
        -H "Host: permtracker.app" -H "x-revalidate-secret: $REVALIDATE_SECRET" \
        http://127.0.0.1:8081/api/revalidate-consular || true
    else
      rc=1; fail ingest_iv_scheduling.py "the IV scheduling table ($f) was refused"
    fi ;;
  # The months of nonimmigrant issuances by post that only the Internet Archive still serves (State's PDFs, March
  # 2017 to September 2022; Nov 5 2026). Run by hand: it loads only months not held, waits between requests, refuses
  # February 2017's by-post-and-nationality layout, and when the Archive stops answering it keeps what it loaded
  # and says where it stopped. The consulate pages rebuild after a write.
  #   sudo -u permtracker permtracker-uscis niv-archive
  niv-archive)
    site_refresh_env
    timeout 180m nice -n 10 python3 scripts/ingest_niv_issuances.py --archive \
      || { rc=1; fail ingest_niv_issuances.py "the Internet Archive's months were refused or ran past 180m"; } ;;
  # Two more State pages copied out of a person's browser (Nov 3 2026), for the bulletin's reason: NVC's
  # timeframes (weekly) and Global Visa Wait Times (monthly). The page's text, or its table as HTML with the
  # "Last updated" line, goes in a file; each reader's own parser and checks decide whether it's written.
  #   sudo -u permtracker permtracker-uscis state-page nvc /tmp/nvc.html
  #   sudo -u permtracker permtracker-uscis state-page wait-times /tmp/wait-times.html
  # Both pages refresh themselves daily, so nothing is expired here. Since Nov 4 2026 two more come the same
  # way: State's visa news (the newsroom's listing and each Visas item's page, as one JSON bundle; the
  # reader asks nginx to rebuild /policy-changes when it writes) and a month's issuance file (the .xlsx
  # State links, its bytes copied from the page; the loader checks it against State's own grand total):
  #   sudo -u permtracker permtracker-uscis state-page news /tmp/state-news.json
  #   sudo -u permtracker permtracker-uscis state-page issuances /tmp/iv-2026-03-post.xlsx 2026-03 post
  # Since Nov 5 2026 two more: a month's NONIMMIGRANT issuances by post (the by-post .xlsx from State's monthly
  # nonimmigrant page, checked against its GRAND TOTAL and that formula's range; the consulate pages rebuild), and
  # a year's table of refusals by ground (the Report of the Visa Office's PDF, checked against its own total line;
  # the year is read from its title, and a year given must match it):
  #   sudo -u permtracker permtracker-uscis state-page niv /tmp/niv-2026-02.xlsx 2026-02
  #   sudo -u permtracker permtracker-uscis state-page refusals /tmp/refusals-fy2024.pdf 2024
  state-page)
    kind="${2:-}"; f="${3:-}"
    usage="usage: permtracker-uscis state-page <nvc|wait-times|news> <file> | state-page issuances <file> <YYYY-MM> <fsc|post> | state-page niv <file> <YYYY-MM> | state-page refusals <file> [<YYYY>]"
    if [ -z "$f" ]; then echo "$usage"; exit 2; fi
    case "$kind" in
      nvc) s=ingest_nvc_timeframes.py; set -- --from-file "$f" ;;
      wait-times) s=ingest_visa_wait_times.py; set -- --from-file "$f" ;;
      news) s=ingest_state_news.py; set -- --bundle "$f" ;;
      issuances)
        m="${4:-}"; d="${5:-}"
        if ! [[ "$m" =~ ^[0-9]{4}-[0-9]{2}$ ]] || ! [[ "$d" =~ ^(fsc|post)$ ]]; then echo "$usage"; exit 2; fi
        s=ingest_visa_issuances.py; set -- --local "$f" --month "$m" --dim "$d" ;;
      niv)
        m="${4:-}"
        if ! [[ "$m" =~ ^[0-9]{4}-[0-9]{2}$ ]]; then echo "$usage"; exit 2; fi
        s=ingest_niv_issuances.py; set -- --local "$f" --month "$m" ;;
      refusals)
        y="${4:-}"
        if [ -n "$y" ] && ! [[ "$y" =~ ^[0-9]{4}$ ]]; then echo "$usage"; exit 2; fi
        s=ingest_visa_refusals.py
        if [ -n "$y" ]; then set -- --local "$f" --fy "$y"; else set -- --local "$f"; fi ;;
      *) echo "$usage"; exit 2 ;;
    esac
    site_refresh_env
    if ! timeout 10m python3 "scripts/$s" "$@"; then
      rc=1; fail "$s" "the $kind copy from a browser ($f) was refused"
    fi ;;
  # The U.S. embassies' Visas feeds copied out of a person's browser (Nov 4 2026): every usembassy.gov site
  # answers scripts with CloudFront's 403, so the session timer embassy-read reads the 20 feeds in
  # scripts/data/embassy_feeds.json in Chrome and hands them over as one JSON copy. The reader keeps the
  # consular notices, writes them to the policy feed and asks nginx to rebuild /policy-changes and the
  # consulate pages.
  #   sudo -u permtracker permtracker-uscis embassy-notices /tmp/embassies.json
  embassy-notices)
    f="${2:-}"
    if [ -z "$f" ]; then echo "usage: permtracker-uscis embassy-notices <file>"; exit 2; fi
    site_refresh_env
    if ! timeout 10m python3 scripts/ingest_embassy_notices.py --bundle "$f"; then
      rc=1; fail ingest_embassy_notices.py "the embassies' copy from a browser ($f) was refused"
    fi ;;
  # A browser timer's heartbeat (Nov 3 2026): the jobs that run in a Claude Code session in the owner's Chrome
  # (the bulletin, State's IV table, NVC and wait times, USCIS's times, the Search Console round) record one
  # every time they fire, due or not, so check_browser_timers in the health check can say when one stopped.
  # The note says what the firing did; one starting "could not read" is a run that couldn't read its page.
  #   sudo -u permtracker permtracker-uscis browser-check state-pages-read "checked, nothing due"
  browser-check)
    name="${2:-}"; note="${3:-checked}"
    case "$name" in
      bulletin-read|iv-tool-read|state-pages-read|uscis-times|gsc-round|embassy-read) ;;
      *) echo "usage: permtracker-uscis browser-check <bulletin-read|iv-tool-read|state-pages-read|uscis-times|gsc-round|embassy-read> [note]"; exit 2 ;;
    esac
    python3 -c 'import sys; sys.path.insert(0, "scripts"); from lib_db import Database, record_run; sys.exit(0 if record_run(Database(), "browser-timer:" + sys.argv[1], status="ok", note=sys.argv[2][:300]) else 1)' "$name" "$note" \
      || { rc=1; echo "the heartbeat for $name was not recorded"; } ;;
  posted-times)
    if timeout 20m nice -n 10 python3 scripts/ingest_uscis_posted_times.py; then
      REVALIDATE_SECRET="$(sed -n 's/^REVALIDATE_SECRET=//p' /srv/permtracker/app/env/production.env | head -1)"
      [ -n "$REVALIDATE_SECRET" ] && curl -s -m 60 -o /dev/null -w "refresh %{http_code}\n" -X POST \
        -H "Host: permtracker.app" -H "x-revalidate-secret: $REVALIDATE_SECRET" \
        http://127.0.0.1:8081/api/revalidate-uscis-times || true
    else
      rc=1; fail ingest_uscis_posted_times.py "exited non-zero or ran past 20m"
    fi ;;
  # SAM.gov's exclusions of PERM sponsors (Oct 31 2026): one public file a day, no key. Read weekly; pages whose
  # exclusions moved rebuild through nginx.
  sam)
    site_refresh_env
    timeout 15m nice -n 10 python3 scripts/ingest_sam_exclusions.py || { rc=1; fail ingest_sam_exclusions.py "exited non-zero or ran past 15m"; } ;;
  # DOL's Trade Adjustment Assistance petitions of PERM sponsors (Oct 31 2026): one 48 MB file from data.dol.gov. The
  # program stopped on July 1 2022, so the file is closed; read monthly to catch a correction or the file moving.
  taa)
    site_refresh_env
    timeout 15m nice -n 10 python3 scripts/ingest_taa.py || { rc=1; fail ingest_taa.py "exited non-zero or ran past 15m"; } ;;
  # SBA's PPP loans to PERM sponsors (Oct 31 2026): thirteen CSVs from data.sba.gov, 5.2 GB, read one at a time into
  # /var/tmp and deleted. The program closed in May 2021 and SBA's release is a snapshot; read monthly.
  ppp)
    site_refresh_env
    timeout 90m nice -n 10 python3 scripts/ingest_ppp.py || { rc=1; fail ingest_ppp.py "exited non-zero or ran past 90m"; } ;;
  i140)
    t=$(mktemp -d)
    # The ingest writes the quarter to the database (perm_docs['uscis_i140']),
    # which the two I-140 tool pages read first since Sep 29 2026, so success
    # here needs no Convex key. With one, Convex's copy (the fallback) is kept
    # current too; without one it is simply left as it was.
    if python3 scripts/ingest_uscis_i140.py --out "$t/uscis-payload.json" && [ -s "$t/uscis-payload.json" ]; then
      file=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("sourceFile", ""))' "$t/uscis-payload.json")
      note="stored $file in the database"
      if [ -n "${CONVEX_DEPLOY_KEY:-}" ]; then
        if npx --yes convex run uscisI140:storeStats "$(cat "$t/uscis-payload.json")" --prod; then note="$note and Convex"
        else note="$note; the Convex fallback copy failed"; fi
      fi
      ok ingest_uscis_i140.py "$note"
    else rc=1; fail ingest_uscis_i140.py "fetch, reduce or database write failed"; fi
    rm -rf "$t"
    python3 scripts/ingest_i140_trends.py || { rc=1; fail ingest_i140_trends.py "ingest exited non-zero"; } ;;
  # USCIS's quarterly performance workbooks, then the I-129 request-for-evidence
  # files USCIS posts with them (Oct 16 2026). Each records its own ok row.
  quarterly) python3 scripts/ingest_uscis_quarterly.py || { rc=1; fail ingest_uscis_quarterly.py "ingest exited non-zero"; }
    python3 scripts/ingest_uscis_rfe.py || { rc=1; fail ingest_uscis_rfe.py "ingest exited non-zero"; } ;;
  # USCIS's H-1B Employer Data Hub (a Tableau export, 75 to 110 MB a year).
  # The ingest records its own ok row, or its refusal with the reason; this adds the timer's row on any non-zero exit.
  # Then the busiest H-1B employers by year and state, which read the hub's rows.
  h1b-hub) nice -n 10 python3 scripts/ingest_uscis_h1b_hub.py || { rc=1; fail ingest_uscis_h1b_hub.py "ingest exited non-zero"; }
    nice -n 10 python3 scripts/build_h1b_ranks.py || { rc=1; fail build_h1b_ranks.py "builder exited non-zero"; } ;;
  # ICE's yearly top-200 OPT and CPT employer lists (a handful of small PDFs).
  sevp) python3 scripts/ingest_sevp_top_employers.py || { rc=1; fail ingest_sevp_top_employers.py "ingest exited non-zero"; } ;;
  # DOL's SeasonalJobs feeds: the H-2A and H-2B applications and job orders DOL
  # accepted, with wage and worksite (published daily at midnight Eastern).
  # The ingest records its own ok or failed row.
  seasonal-jobs) python3 scripts/ingest_seasonal_jobs.py || { rc=1; fail ingest_seasonal_jobs.py "ingest exited non-zero"; } ;;
  # The reference sources beside the PERM record (Oct 5 2026). Each loader
  # records its own ok or failed row and skips a file it has already loaded.
  # Census runs after the wage tables: it reads DOL's county-to-area list.
  # BEA's loader exits cleanly until BEA_API_KEY is in uscis.env.
  reference)
    for s in ingest_onet.py ingest_bls.py ingest_oflc_wages.py ingest_census_geo.py ingest_bea_rpp.py; do
      nice -n 10 python3 "scripts/$s" || { rc=1; fail "$s" "ingest exited non-zero"; }
    done ;;
  # State's monthly immigrant visa issuances (adoption.state.gov; travel.state.gov refuses scripts).
  visa-issuances) nice -n 10 python3 scripts/ingest_visa_issuances.py || { rc=1; fail ingest_visa_issuances.py "ingest exited non-zero"; } ;;
  # The estimate backtests' second clock (Oct 8 2026). GitHub's full pass runs
  # them every night; this runs them again each morning, so one failed night
  # never leaves the case page's measured range unrefreshed. Each gets one
  # retry; two failures record a failure row the health check reports.
  backtests)
    for s in backtest_queue.py backtest_pwd.py; do
      if nice -n 10 python3 "scripts/$s" --write > /dev/null; then ok "$s" "measured and written"
      else
        sleep 600
        if nice -n 10 python3 "scripts/$s" --write > /dev/null; then ok "$s" "written on the retry"
        else rc=1; fail "$s" "failed twice"; fi
      fi
    done ;;
  # DOL's H-2B assignment-group lists, read only when new or changed, and
  # each group's timing rebuilt from the night's statuses (Oct 8 2026).
  h2b-groups) nice -n 10 python3 scripts/ingest_h2b_groups.py || { rc=1; fail ingest_h2b_groups.py "ingest exited non-zero"; } ;;
  # Every policy source read every 30 minutes, day and night (Oct 27 2026), so
  # a rule, a filing or an announcement reaches the policy page and the
  # evening check within half an hour: OIRA's review lists, the Federal
  # Register's public inspection list and newest documents, the White House's
  # presidential actions, and USCIS's newsroom and Policy Manual. Each step
  # has its own time limit and records its own failure, so one source's bad
  # half hour never costs the others; a source that refuses is a warning in its
  # own run row, and its freshness row is the alarm. A step that wrote
  # something asks the site to rebuild the policy page (through nginx, which
  # sends the call to both web copies). DOL's newsroom and OFLC are read from
  # GitHub's runners (www.dol.gov refuses this server).
  policy-watch)
    site_refresh_env
    # One source down is that source's failure row (the health check and the
    # morning report name it), not this unit's failure: reginfo.gov's 502s and
    # a cut-off robots.txt failed the unit every 30 minutes on Oct 30 and 31
    # 2026, and the alarm emailed for each. The unit fails only when every
    # source failed in one run, which says the server, not a source, is broken.
    ran=0; failed=0
    step(){ limit="$1"; s="$2"; shift 2; ran=$((ran + 1))
      timeout "$limit" nice -n 5 python3 "scripts/$s" "$@" \
        || { failed=$((failed + 1)); fail "$s" "exited non-zero or ran past $limit"; echo "::warning::$s failed"; }; }
    # The rule watch says whether a rule moved through GitHub's output file, which
    # this server reads the same way the workflow does.
    out="$(mktemp)"
    export GITHUB_OUTPUT="$out"
    step 6m ingest_rule_pipeline.py
    unset GITHUB_OUTPUT
    if grep -q '^rules_changed=true' "$out"; then
      curl -fsS -o /dev/null -X POST -H "Host: permtracker.app" -H "x-revalidate-secret: $REVALIDATE_SECRET" \
        "$REVALIDATE_BASE/api/revalidate-policy" || echo "::warning::revalidate-policy call failed after the rule watch"
    fi
    rm -f "$out"
    step 10m ingest_policy_notices.py --days 3 --inspection
    step 4m ingest_white_house.py
    step 6m ingest_uscis_news.py
    step 8m ingest_state_news.py
    # The Justice Department's releases on work-visa sponsors, IER's settlements
    # list and OCAHO's orders (Nov 1 2026). DOJ asks 10 seconds between
    # requests; the reader reads the two lists at most every 6 hours.
    step 4m ingest_doj_enforcement.py
    # api.data.gov (regulations.gov comment counts, congress.gov bills): every
    # run with the site's key (DATA_GOV_API_KEY, uscis.env, since Oct 27 2026);
    # without it, DEMO_KEY's 50 requests a day allow only the 7:07 AM and
    # 5:07 PM Eastern runs.
    h=$(TZ=America/New_York date +%-H); m=$(TZ=America/New_York date +%-M)
    if [ -n "${DATA_GOV_API_KEY:-}" ] || { { [ "$h" = 7 ] || [ "$h" = 17 ]; } && [ "$m" -lt 30 ]; }; then
      step 4m ingest_regulations_gov.py
      step 4m ingest_congress_bills.py
    fi
    # Federal court opinions from CourtListener's API (Oct 27 2026). The reader
    # asks at most once every 3 hours (it reads its own last run), and a search
    # can take minutes, so it has its own limit. COURTLISTENER_TOKEN in
    # uscis.env, when set, is sent as CourtListener asks.
    step 12m ingest_court_opinions.py
    # The filings in the court cases followed by name (scripts/data/court_dockets.json), from CourtListener's
    # RECAP archive (Nov 3 2026): it reads its own last run and asks at most every 6 hours, three requests.
    step 6m ingest_court_dockets.py
    # Sundays at 3 AM Eastern, a five-page walk for opinions posted late.
    if [ "$(TZ=America/New_York date +%u)" = 7 ] && [ "$h" = 3 ] && [ "$m" -lt 30 ]; then
      step 20m ingest_court_opinions.py --pages 5
    fi
    echo "policy-watch: $failed of $ran sources failed"
    if [ "$ran" -gt 0 ] && [ "$failed" -eq "$ran" ]; then rc=1; fi ;;
  *) echo "unknown job $job"; exit 2 ;;
esac
exit $rc
