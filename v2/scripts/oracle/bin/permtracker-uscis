#!/bin/bash
# permtracker-uscis <i485|i140|quarterly|h1b-hub|sevp|seasonal-jobs|reference|visa-issuances|backtests>: the USCIS fetches that ran on the
# owner's Mac until Sep 28 2026, moved here because www.uscis.gov answers this server.
# Same scripts, same failure recording.
set -uo pipefail
job="$1"; R=/srv/permtracker/repo; V2=$R/v2
git -C "$R" fetch -q origin main && git -C "$R" reset -q --hard origin/main
set -a; . /srv/permtracker/app/env/uscis.env; set +a
cd "$V2"
fail(){ python3 scripts/record_ingest_failure.py --script "$1" --note "oracle timer ($job): $2" || echo "could not record the failure row"; }
# A clean run writes its own ok row: the failure recorder refuses "ok" on
# purpose, and the I-140 script records nothing when it succeeds, so without
# this one failed run kept the health check red for its whole window.
ok(){ python3 -c 'import sys; sys.path.insert(0, "scripts"); from lib_turso import Turso, record_run; record_run(Turso(), sys.argv[1], status="ok", note=sys.argv[2])' "$1" "oracle timer ($job): $2" || echo "could not record the ok row"; }
rc=0
case "$job" in
  i485) python3 scripts/ingest_i485_inventory.py || { rc=1; fail ingest_i485_inventory.py "ingest exited non-zero"; } ;;
  i140)
    t=$(mktemp -d)
    # The ingest writes the quarter to the database (perm_docs['uscis_i140']),
    # which the two I-140 tool pages read first since Sep 29 2026, so success
    # here needs no Convex key. With one, Convex's copy (the fallback) is kept
    # current too; without one it is simply left as it was.
    if python3 scripts/ingest_uscis_i140.py --out "$t/uscis-payload.json" && [ -s "$t/uscis-payload.json" ]; then
      file=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("sourceFile", ""))' "$t/uscis-payload.json")
      note="stored $file in the database"
      if [ -n "${CONVEX_DEPLOY_KEY:-}" ]; then
        if npx --yes convex run uscisI140:storeStats "$(cat "$t/uscis-payload.json")" --prod; then note="$note and Convex"
        else note="$note; the Convex fallback copy failed"; fi
      fi
      ok ingest_uscis_i140.py "$note"
    else rc=1; fail ingest_uscis_i140.py "fetch, reduce or database write failed"; fi
    rm -rf "$t"
    python3 scripts/ingest_i140_trends.py || { rc=1; fail ingest_i140_trends.py "ingest exited non-zero"; } ;;
  quarterly) python3 scripts/ingest_uscis_quarterly.py || { rc=1; fail ingest_uscis_quarterly.py "ingest exited non-zero"; } ;;
  # USCIS's H-1B Employer Data Hub (a Tableau export, 75 to 110 MB a year).
  # The ingest records its own ok row, or its refusal with the reason; this adds the timer's row on any non-zero exit.
  h1b-hub) nice -n 10 python3 scripts/ingest_uscis_h1b_hub.py || { rc=1; fail ingest_uscis_h1b_hub.py "ingest exited non-zero"; } ;;
  # ICE's yearly top-200 OPT and CPT employer lists (a handful of small PDFs).
  sevp) python3 scripts/ingest_sevp_top_employers.py || { rc=1; fail ingest_sevp_top_employers.py "ingest exited non-zero"; } ;;
  # DOL's SeasonalJobs feeds: the H-2A and H-2B applications and job orders DOL
  # accepted, with wage and worksite (published daily at midnight Eastern).
  # The ingest records its own ok or failed row.
  seasonal-jobs) python3 scripts/ingest_seasonal_jobs.py || { rc=1; fail ingest_seasonal_jobs.py "ingest exited non-zero"; } ;;
  # The reference sources beside the PERM record (Oct 5 2026). Each loader
  # records its own ok or failed row and skips a file it has already loaded.
  # Census runs after the wage tables: it reads DOL's county-to-area list.
  # BEA's loader exits cleanly until BEA_API_KEY is in uscis.env.
  reference)
    for s in ingest_onet.py ingest_bls.py ingest_oflc_wages.py ingest_census_geo.py ingest_bea_rpp.py; do
      nice -n 10 python3 "scripts/$s" || { rc=1; fail "$s" "ingest exited non-zero"; }
    done ;;
  # State's monthly immigrant visa issuances (adoption.state.gov; travel.state.gov refuses scripts).
  visa-issuances) nice -n 10 python3 scripts/ingest_visa_issuances.py || { rc=1; fail ingest_visa_issuances.py "ingest exited non-zero"; } ;;
  # The estimate backtests' second clock (Oct 8 2026). GitHub's full pass runs
  # them every night; this runs them again each morning, so one failed night
  # never leaves the case page's measured range unrefreshed. Each gets one
  # retry; two failures record a failure row the health check reports.
  backtests)
    for s in backtest_queue.py backtest_pwd.py; do
      if nice -n 10 python3 "scripts/$s" --write > /dev/null; then ok "$s" "measured and written"
      else
        sleep 600
        if nice -n 10 python3 "scripts/$s" --write > /dev/null; then ok "$s" "written on the retry"
        else rc=1; fail "$s" "failed twice"; fi
      fi
    done ;;
  *) echo "unknown job $job"; exit 2 ;;
esac
exit $rc
