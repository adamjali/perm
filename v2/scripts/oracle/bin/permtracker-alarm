#!/usr/bin/env python3
"""Every 5 minutes: email the owner the moment the server heads into trouble,
and fix what can be fixed first.

WHY. On Oct 10 2026 the 145 GB disk filled (about 5:20 to 8:27 AM EDT). Free
space had fallen at a steady 3.5 GB an hour for a whole day, but disk was read
once a day, by the 7:30 AM report, and every monitor on the box (the watchdog,
the defense, the health sampler) kept its state on the same disk and went
blind with it. The database refused writes for three hours before anyone knew.

So this job never touches the disk: its own memory is in /run (RAM), it reads
only what the kernel and systemd report, and it emails through Resend's API
directly. It runs as root (systemd: permtracker-alarm.timer).

CHECKS. Each is one alarm: emailed when it starts, again every 6 hours while it
lasts, and once when it clears. At most 12 alarm emails a day (Resend's 100 a
day is shared with every subscriber's mail).

  disk        under 25 GB free, or full within 24 hours at the last two
              hours' rate (with at least an hour of readings), unless the
              page-cache cap would stop that fall with 20 GB still free. Once
              on, it clears only 5 GB (or 6 hours) past its line, so a reading
              sitting on the line can't switch it on and off every check
  disk-crit   under 10 GB free
  memory      under 500 MB available, or swap moving over 100 pages a second
              while under 2 GB of memory is available (swap that only holds
              old pages costs nothing). Once on, it clears 256 MB above its
              lines and with swap under half its rate, so a reading sitting on
              a line can't switch it on and off every check
  units       a PERM Tracker job or service, nginx, cloudflared or the
              database is in systemd's "failed" state, or is switched on but
              stopped after an error (a crash into systemd's start limit
              leaves a unit "inactive", which --failed never lists)
  sampler     the health sampler has written nothing for 30 minutes
  page-cache  the page-cache cap has not finished for 2.5 hours
  backup      the nightly backup's last success is over 30 hours old

WHAT IT FIXES before it emails:
  disk        starts the page-cache cap now (it switches to tight budgets
              under 20 GB free) instead of waiting up to 30 minutes
  disk-crit   deletes the route cache of every release the live slot does not
              run from (the standby's too: a rollback renders it again), which
              takes seconds where the cap's page-by-page walk takes minutes;
              then starts the cap for the live copies

`--dry-run` prints what it would send and do, and changes nothing.
"""
from __future__ import annotations

import json
import os
import pathlib
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

APP = pathlib.Path(os.environ.get("PT_APP_ROOT", "/srv/permtracker"))
RUN = pathlib.Path(os.environ.get("PT_RUN_DIR", "/run/permtracker"))
STATE = RUN / "alarm.json"
CONFIG = pathlib.Path("/etc/permtracker/defend.env")      # ALERT_TO, shared with the defense
APP_ENV = APP / "app" / "env" / "production.env"         # RESEND_API_KEY
# The mail Worker on Cloudflare (workers/mail/): free mail to the owner, outside
# Resend's 100 a day. OWNER_MAIL_URL and OWNER_MAIL_KEY; Resend when unset or down.
OWNER_MAIL = pathlib.Path("/etc/permtracker/owner-mail.env")
USER_AGENT = "permtracker-alarm/1.0 (+https://permtracker.app)"  # Cloudflare 403s Python's default
GB = 1024 ** 3
ET = ZoneInfo("America/New_York")

DISK_LOW_GB = 25
DISK_CRIT_GB = 10
FULL_WITHIN_H = 24
# The cap switches to tight budgets under this much free, so a fall it will stop
# with this much left can't fill the disk.
DISK_FLOOR_GB = 20
# An alarm already on clears only this far past its lines. Oct 19 to 20 2026: the
# caches' floor sat at 24 to 25 GB against a 25 GB line, and the disk alarm
# started and cleared five times in three hours (ten emails) with 28 GB free.
DISK_CLEAR_MARGIN_GB = 5
DISK_CLEAR_MARGIN_H = 6
TREND_WINDOW_S = 2 * 3600       # the rate is read over the last two hours
TREND_MIN_S = 3600              # ... once there is at least an hour of readings
HISTORY_S = 6 * 3600            # readings kept in /run
MEM_MIN_MB = 500
SWAP_SHORT_MEM_MB = 2048
# Pages a second moved to or from swap that count as the server swapping
# (daily_monitor.py's SWAP_ACTIVE_PAGES_S). Oct 28 2026: with the database
# file locked in RAM, 2.5 to 3.6 GB of old pages sat in swap moving about 42
# a second, and the old "over 2 GB of swap" rule emailed five times in a day.
SWAP_ACTIVE_PAGES_S = 100
MEM_CLEAR_MARGIN_MB = 256
SAMPLER_STALE_S = 30 * 60
PRUNE_STALE_S = int(2.5 * 3600)
# A release whose .next/server holds this much more than the cap counted has
# pages in a folder the cap doesn't read (the cap records both figures).
UNCOUNTED_GB = 15
BACKUP_STALE_S = 30 * 3600
REMIND_S = 6 * 3600
EMAILS_PER_DAY = 12
# Units that are ours (or that the site cannot run without). Anything else
# systemd lists as failed (fwupd, PCP's loggers) is the OS's business.
OUR_UNITS = ("permtracker", "nginx", "cloudflared", "sqld")

DRY_RUN = "--dry-run" in sys.argv


# --------------------------------------------------------------------------
# Pure parts (tested in scripts/oracle/test_alarm.py)
# --------------------------------------------------------------------------

def rate_gb_per_hour(points: list[list[float]], now: float) -> float | None:
    """Free-space change in GB an hour over the trend window; positive = filling.

    None until the window holds at least TREND_MIN_S of readings.
    """
    pts = [(t, free) for t, free in points if now - t <= TREND_WINDOW_S]
    if len(pts) < 3 or pts[-1][0] - pts[0][0] < TREND_MIN_S:
        return None
    n = len(pts)
    mt = sum(t for t, _ in pts) / n
    mf = sum(f for _, f in pts) / n
    var = sum((t - mt) ** 2 for t, _ in pts)
    if var == 0:
        return None
    slope = sum((t - mt) * (f - mf) for t, f in pts) / var   # GB per second, free
    return -slope * 3600


def swap_rate(prev: list | None, now: float, pages: int | None) -> float | None:
    """Pages a second moved to or from swap since the last reading, or None.

    None on the first run, after a reboot (the counter starts again) or across
    a gap of an hour or more.
    """
    if not prev or pages is None:
        return None
    t, before = prev
    dt = now - t
    if not 60 <= dt < 3600 or pages < before:
        return None
    return round((pages - before) / dt, 1)


def evaluate(snap: dict, rate: float | None, already_on=()) -> dict[str, str]:
    """The alarms on now, each with its one-line reason.

    `already_on` names the alarms on at the last check: the disk alarm's lines
    move out by DISK_CLEAR_MARGIN_GB and DISK_CLEAR_MARGIN_H while it is on.
    """
    on: dict[str, str] = {}
    free = snap["disk_free_gb"]
    hours = free / rate if rate and rate > 0.2 else None
    held = "disk" in already_on
    margin_gb = DISK_CLEAR_MARGIN_GB if held else 0
    within_h = FULL_WITHIN_H + (DISK_CLEAR_MARGIN_H if held else 0)
    # A fall the page-cache cap will stop isn't the disk filling: the cached
    # pages grow until their budgets and no further, so if the disk would
    # still have DISK_FLOOR_GB free with every cache at its budget, the trend
    # alone raises nothing (Oct 10 2026: the live cache refilling toward its
    # 60 GB read as "full in 12 hours" with 37 GB to spare). Unknown headroom,
    # or a cache the cap can't see, keeps the plain trend.
    headroom = snap.get("cache_headroom_gb")
    if (hours is not None and headroom is not None and not snap.get("uncounted")
            and free - headroom >= DISK_FLOOR_GB + margin_gb):
        hours = None
    if free < DISK_CRIT_GB:
        on["disk-crit"] = f"only {free:.1f} GB of the disk is free"
    if free < DISK_LOW_GB + margin_gb or (hours is not None and hours < within_h):
        why = f"{free:.1f} GB free"
        if hours is not None:
            why += f", falling {rate:.1f} GB an hour: full in about {hours:.0f} hours"
        on["disk"] = why
    # Swap that only holds pages set aside earlier costs nothing; swap MOVING
    # while memory is short is what slows the site (the morning report's rule).
    # Once on, its lines move out so a reading on a line can't flip it.
    mem_held = "memory" in already_on
    margin_mb = MEM_CLEAR_MARGIN_MB if mem_held else 0
    swapping = snap.get("swap_rate")
    swap_line = SWAP_ACTIVE_PAGES_S / 2 if mem_held else SWAP_ACTIVE_PAGES_S
    avail = snap["mem_available_mb"]
    if avail < MEM_MIN_MB + margin_mb or (swapping is not None and swapping > swap_line
                                          and avail < SWAP_SHORT_MEM_MB + margin_mb):
        moving = "" if swapping is None else f", {swapping:g} pages a second moving"
        on["memory"] = (f"{avail} MB of memory available, "
                        f"{snap['swap_used_mb']} MB of swap in use{moving}")
    down = []
    if snap["failed_units"]:
        down.append("failed: " + ", ".join(sorted(snap["failed_units"])))
    if snap.get("stopped_units"):
        down.append("stopped after an error: " + ", ".join(sorted(snap["stopped_units"])))
    if down:
        on["units"] = "; ".join(down)
    for key, age, limit, what in (
            ("sampler", snap.get("sampler_age_s"), SAMPLER_STALE_S, "the health sampler"),
            ("page-cache", snap.get("prune_age_s"), PRUNE_STALE_S, "the page-cache cap"),
            ("backup", snap.get("backup_age_s"), BACKUP_STALE_S, "the nightly backup")):
        if age is None or age > limit:
            when = "never" if age is None else f"{age / 3600:.1f} hours ago"
            on[key] = f"{what} last finished {when}"
    if snap.get("uncounted"):
        on["page-cache-blind"] = ("Next holds pages the page-cache cap doesn't count: "
                                  + "; ".join(snap["uncounted"]))
    return on


def cache_headroom(report: dict) -> float | None:
    """GB the page caches may still grow before the cap stops them, or None if unreadable."""
    total = 0.0
    for r in report.get("releases", []):
        budget, gb = r.get("budgetGB"), r.get("gb")
        if not isinstance(budget, (int, float)) or not isinstance(gb, (int, float)):
            return None
        total += max(0.0, budget - gb)
    return total


def uncounted_releases(report: dict) -> list[str]:
    """Releases holding UNCOUNTED_GB more in .next/server than the cap counted."""
    out = []
    for r in report.get("releases", []):
        server, counted = r.get("serverGB"), r.get("gb")
        if isinstance(server, (int, float)) and isinstance(counted, (int, float)) and server - counted > UNCOUNTED_GB:
            out.append(f"{r.get('release')} ({server:.0f} GB on disk, {counted:.0f} GB counted)")
    return out


def plan(on: dict[str, str], state: dict, now: float) -> tuple[list[tuple[str, str, str]], dict]:
    """Which emails to send: (key, kind, reason), kind start | still | clear."""
    alarms = dict(state.get("alarms", {}))
    out: list[tuple[str, str, str]] = []
    for key, reason in on.items():
        a = alarms.get(key)
        if a is None:
            out.append((key, "start", reason))
            alarms[key] = {"since": now, "mailed": now, "reason": reason}
        elif now - a.get("mailed", 0) >= REMIND_S:
            out.append((key, "still", reason))
            alarms[key] = {**a, "mailed": now, "reason": reason}
        else:
            alarms[key] = {**a, "reason": reason}
    for key in list(alarms):
        if key not in on:
            out.append((key, "clear", alarms[key].get("reason", "")))
            del alarms[key]
    return out, {**state, "alarms": alarms}


def under_cap(state: dict, now: float) -> bool:
    day = datetime.fromtimestamp(now, timezone.utc).strftime("%Y-%m-%d")
    return state.get("emails", {}).get(day, 0) < EMAILS_PER_DAY


def count_email(state: dict, now: float) -> dict:
    day = datetime.fromtimestamp(now, timezone.utc).strftime("%Y-%m-%d")
    sent = {d: n for d, n in state.get("emails", {}).items() if d >= day}
    sent[day] = sent.get(day, 0) + 1
    return {**state, "emails": sent}


# --------------------------------------------------------------------------
# Reading the machine
# --------------------------------------------------------------------------

def age_of(path: pathlib.Path, now: float) -> float | None:
    try:
        return now - path.stat().st_mtime
    except OSError:
        return None


def stopped_after_error(show: str) -> list[str]:
    """Services switched on yet stopped after an error, from `systemctl show
    -p Id -p ActiveState -p Result -p UnitFileState`. A unit that crashes into
    systemd's start limit is left "inactive", which `systemctl --failed` never
    lists (PCP's pmlogger, Oct 10 2026). Same rule as permtracker-health's."""
    out = []
    for block in show.split("\n\n"):
        f = dict(ln.split("=", 1) for ln in block.splitlines() if "=" in ln)
        if (f.get("ActiveState") == "inactive" and f.get("Result", "success") != "success"
                and f.get("UnitFileState", "").startswith("enabled")):
            out.append(f["Id"])
    return sorted(out)


def snapshot(now: float) -> dict:
    disk = shutil.disk_usage("/")
    mem = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        mem[k] = int(v.split()[0])
    failed = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain"],
                            capture_output=True, text=True).stdout.splitlines()
    units = [ln.split()[0] for ln in failed if ln.strip()]
    ours = subprocess.run(["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--plain",
                           *(f"{u}*" for u in OUR_UNITS)], capture_output=True, text=True).stdout.splitlines()
    names = [ln.split()[0] for ln in ours if ln.strip()]
    stopped = stopped_after_error(subprocess.run(
        ["systemctl", "show", "-p", "Id", "-p", "ActiveState", "-p", "Result", "-p", "UnitFileState", *names],
        capture_output=True, text=True).stdout) if names else []
    prune_age = None
    uncounted: list[str] = []
    headroom = None
    try:
        report = json.loads((APP / "health" / "prune.json").read_text())
        prune_age = now - report["at"]
        uncounted = uncounted_releases(report)
        headroom = cache_headroom(report) if prune_age <= PRUNE_STALE_S else None
    except (OSError, ValueError, KeyError, TypeError):
        pass
    swapped = None
    try:
        swapped = sum(int(ln.split()[1]) for ln in open("/proc/vmstat")
                      if ln.startswith(("pswpin ", "pswpout ")))
    except (OSError, ValueError, IndexError):
        pass
    return {
        "swap_pages": swapped,
        "disk_free_gb": disk.free / GB,
        "mem_available_mb": mem.get("MemAvailable", 0) // 1024,
        "swap_used_mb": (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) // 1024,
        "failed_units": [u for u in units if u.startswith(OUR_UNITS)],
        "stopped_units": [u for u in stopped if u.startswith(OUR_UNITS)],
        "sampler_age_s": age_of(APP / "health" / "samples.jsonl", now),
        "prune_age_s": prune_age,
        "uncounted": uncounted,
        "cache_headroom_gb": headroom,
        "backup_age_s": age_of(APP / "backups" / "LAST_OK", now),
    }


# --------------------------------------------------------------------------
# Fixing what can be fixed
# --------------------------------------------------------------------------

def live_dirs() -> set[str]:
    app = APP / "app"
    try:
        slot = (app / "active").read_text().strip()
    except OSError:
        return set()
    return {os.path.realpath(app / "slots" / s) for s in (slot, slot + "2")
            if (app / "slots" / s).exists()}


def drop_route_caches() -> list[str]:
    """Delete the route cache of every release the live slot does not run from."""
    keep = live_dirs()
    if not keep:
        return []          # without knowing the live slot, delete nothing
    done = []
    for rel in sorted((APP / "app" / "releases").iterdir()):
        if os.path.realpath(rel) in keep:
            continue
        cache = rel / ".next" / "server" / "route-cache"
        if cache.is_dir():
            if not DRY_RUN:
                shutil.rmtree(cache, ignore_errors=True)
            done.append(rel.name)
    return done


def start_prune() -> None:
    if not DRY_RUN:
        subprocess.run(["systemctl", "start", "--no-block", "permtracker-prune.service"],
                       capture_output=True)


def heal(on: dict[str, str]) -> list[str]:
    actions = []
    if "disk-crit" in on:
        dropped = drop_route_caches()
        if dropped:
            actions.append("deleted the page cache of the releases not serving the site: "
                           + ", ".join(dropped))
    if "disk" in on or "disk-crit" in on:
        start_prune()
        actions.append("started the page-cache cap (it runs tight budgets under 20 GB free)")
    return actions


# --------------------------------------------------------------------------
# Telling the owner
# --------------------------------------------------------------------------

TITLES = {
    "disk": "the disk is filling", "disk-crit": "the disk is nearly full",
    "memory": "memory is low", "units": "a job or service failed",
    "sampler": "the health sampler stopped", "page-cache": "the page-cache cap stopped",
    "backup": "the nightly backup is late",
    "page-cache-blind": "the page-cache cap can't see some pages",
}
# What each alarm clearing means, said as the good news. The Oct 10 2026 clear
# was titled "back to normal (the disk is filling)" and repeated the old
# "full in about 12 hours" under CLEARED, which read as the disk still filling.
CLEARED = {
    "disk": "the disk is no longer on course to fill", "disk-crit": "the disk has room again",
    "memory": "memory has recovered", "units": "no job or service is down",
    "sampler": "the health sampler is running again", "page-cache": "the page-cache cap is running again",
    "backup": "the nightly backup has run",
    "page-cache-blind": "the page-cache cap can see every page again",
}


def read_env(path: pathlib.Path) -> dict:
    out = {}
    try:
        for ln in path.read_text().splitlines():
            if "=" in ln and not ln.lstrip().startswith("#"):
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def via_worker(subject: str, text: str) -> bool:
    """Send through the mail Worker. False when it isn't set up or didn't take it."""
    cfg = read_env(OWNER_MAIL)
    url, key = cfg.get("OWNER_MAIL_URL"), cfg.get("OWNER_MAIL_KEY")
    if not url or not key:
        return False
    req = urllib.request.Request(
        url, method="POST", data=json.dumps({"subject": subject, "text": text}).encode(),
        headers={"x-owner-mail-key": key, "Content-Type": "application/json", "User-Agent": USER_AGENT})
    try:
        urllib.request.urlopen(req, timeout=15).read()
        return True
    except (urllib.error.URLError, OSError) as exc:
        print(f"mail Worker failed, using Resend: {exc}")
        return False


def send(subject: str, text: str) -> bool:
    if DRY_RUN:
        print(f"would email: {subject}\n{text}\n")
        return True
    if via_worker(subject, text):
        return True
    key = read_env(APP_ENV).get("RESEND_API_KEY")
    to = read_env(CONFIG).get("ALERT_TO")
    if not key or not to:
        print("no RESEND_API_KEY or ALERT_TO; cannot email")
        return False
    req = urllib.request.Request(
        "https://api.resend.com/emails", method="POST",
        data=json.dumps({"from": "PERM Tracker <notifications@permtracker.app>", "to": [to],
                         "subject": subject, "text": text}).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json",
                 "User-Agent": USER_AGENT})
    try:
        urllib.request.urlopen(req, timeout=20).read()
        return True
    except (urllib.error.URLError, OSError) as exc:
        print(f"email failed: {exc}")
        return False


def compose(mail: list[tuple[str, str, str]], snap: dict, rate: float | None,
            actions: list[str], now: float) -> tuple[str, str]:
    stamp = datetime.fromtimestamp(now, ET).strftime("%A %b %-d, %-I:%M %p %Z")
    starts = [m for m in mail if m[1] != "clear"]
    if starts:
        subject = "PERM Tracker server: " + "; ".join(TITLES.get(k, k) for k, _, _ in starts)
    else:
        subject = "PERM Tracker server: back to normal, " + "; ".join(CLEARED.get(k, k) for k, _, _ in mail)
    lines = [f"Checked {stamp}.", ""]
    for key, kind, reason in mail:
        if kind == "clear":
            lines.append(f"CLEARED: {CLEARED.get(key, key)}. (It had said: {reason}.)")
        else:
            word = {"start": "NEW", "still": "STILL"}[kind]
            lines.append(f"{word}: {TITLES.get(key, key)}. {reason}.")
    if actions:
        lines += ["", "Done automatically:"] + [f"- {a}." for a in actions]
    # rate is GB an hour the disk is LOSING; say it in that direction.
    if rate is None:
        trend = ""
    elif rate >= 0:
        trend = f", falling {rate:.1f} GB an hour"
    else:
        trend = f", rising {-rate:.1f} GB an hour"
    lines += ["", f"Disk: {snap['disk_free_gb']:.1f} GB free{trend}. "
                  f"Memory: {snap['mem_available_mb']} MB available, {snap['swap_used_mb']} MB swap."]
    headroom = snap.get("cache_headroom_gb")
    if headroom is not None and rate is not None and rate > 0 and not snap.get("uncounted"):
        floor = snap["disk_free_gb"] - headroom
        lines.append(f"The page caches may grow {headroom:.1f} GB more before their cap stops them, "
                     f"which would leave about {floor:.0f} GB free.")
    lines += ["This alarm runs every 5 minutes on the server (permtracker-alarm); it emails again "
              "every 6 hours while something lasts, and once when it clears."]
    return subject, "\n".join(lines)


def main() -> int:
    now = time.time()
    RUN.mkdir(parents=True, exist_ok=True)
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    snap = snapshot(now)
    points = [p for p in state.get("disk", []) if now - p[0] <= HISTORY_S]
    points.append([now, round(snap["disk_free_gb"], 2)])
    state["disk"] = points
    rate = rate_gb_per_hour(points, now)
    snap["swap_rate"] = swap_rate(state.get("swap"), now, snap.get("swap_pages"))
    if snap.get("swap_pages") is not None:
        state["swap"] = [now, snap["swap_pages"]]
    on = evaluate(snap, rate, state.get("alarms", {}).keys())
    actions = heal(on)
    mail, planned = plan(on, state, now)
    undelivered = False
    if not mail:
        state = planned
    elif under_cap(state, now):
        if send(*compose(mail, snap, rate, actions, now)):
            state = count_email(planned, now)
        else:
            # Nothing is marked sent, so the next run (5 minutes) tries again,
            # and this run exits 1: a missing key or a refusal had only printed
            # to the journal, so the unit never showed as failed and nothing
            # noticed that the last-line alarm couldn't email anyone.
            undelivered = True
    # else: over the day's cap; nothing is marked sent, which is the cap working
    if not DRY_RUN:
        STATE.write_text(json.dumps(state))
    print(f"free {snap['disk_free_gb']:.1f} GB, rate "
          f"{'n/a' if rate is None else f'{rate:+.2f} GB/h'}, alarms {sorted(on) or 'none'}"
          + (f", emailed {[(k, kind) for k, kind, _ in mail]}" if mail and not undelivered else "")
          + (", an email was due and could NOT be sent" if undelivered else ""))
    return 1 if undelivered else 0


if __name__ == "__main__":
    sys.exit(main())
