#!/usr/bin/env python3
"""Every 10 minutes: the server's own health, written into its database.

The morning report (scripts/daily_monitor.py, section "server") reads
perm_docs['server_health']. Seven days of samples are kept on disk in
/srv/permtracker/health/samples.jsonl because that is the window Oracle's
idle rule is measured over: an Always Free A1 instance whose CPU (95th
percentile), network and memory all stay under 20% for 7 days can be
reclaimed. The database locked in RAM (permtracker-dbcache) is what keeps
memory above that line; this is how anyone finds out if it stops.

CPU and network are averages since the previous sample (about 10 minutes),
read from the kernel's own counters. Oracle averages per minute, so its
95th percentile runs a little higher than this one; the line is the same.
"""
import json
import os
import pathlib
import re
import shutil
import subprocess
import time
import urllib.request
from datetime import datetime

APP = pathlib.Path("/srv/permtracker")
HERE = APP / "health"
SAMPLES = HERE / "samples.jsonl"
STATE = HERE / "counters.json"
WEEK_S = 7 * 86_400
NIC_MBPS = 2_000  # A1.Flex gets 1 Gbps per OCPU; this shape has 2
SERVICES = ["permtracker-db", "permtracker-dbcache", "permtracker-web@blue",
            "permtracker-web@green", "nginx", "cloudflared"]


def cpu_counters():
    f = [int(x) for x in open("/proc/stat").readline().split()[1:]]
    idle = f[3] + f[4]  # idle + iowait
    return sum(f), idle


def net_counters():
    rx = tx = 0
    for line in open("/proc/net/dev").readlines()[2:]:
        name, rest = line.split(":", 1)
        if name.strip() == "lo":
            continue
        v = rest.split()
        rx, tx = rx + int(v[0]), tx + int(v[8])
    return rx, tx


def disk_hours_to_full(samples: list, now: float, window_s: int = 6 * 3600):
    """Hours until free disk reaches zero at the last six hours' rate, or None.

    None when free disk is not falling, or with under two hours of readings.
    On Oct 9 2026 this would have read about 23 hours with 82 GB still free.
    """
    pts = [(s["t"], s["disk"]) for s in samples
           if s.get("disk") is not None and now - s["t"] <= window_s]
    if len(pts) < 3 or pts[-1][0] - pts[0][0] < 2 * 3600:
        return None
    n = len(pts)
    mt = sum(t for t, _ in pts) / n
    mf = sum(f for _, f in pts) / n
    var = sum((t - mt) ** 2 for t, _ in pts)
    if not var:
        return None
    per_hour = -sum((t - mt) * (f - mf) for t, f in pts) / var * 3600
    if per_hour <= 0.1:
        return None
    return round(pts[-1][1] / per_hour, 1)


def meminfo():
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0])
    return m


def active(unit):
    r = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True)
    return r.stdout.strip() or "unknown"


BUSY_LOG = pathlib.Path("/var/log/permtracker-busy/seen.log")
# Not people: crawlers and scripts that happen to render pages.
NOT_PERSON = re.compile(r"bot|crawl|spider|slurp|externalagent|externalhit|fetcher|headless|lighthouse|python|curl|wget|httpclient|java/|go-http|node-fetch|axios|okhttp|scrapy|playwright|puppeteer|phantom",
                        re.I)
BUSY_LINE = re.compile(r'^(\S+) (\d{3}) (\S+) (\S*) "(.*)"$')


def busy_seen(now: float, log: pathlib.Path = BUSY_LOG) -> dict | None:
    """People shown a refusal page, from nginx's log of its counting image
    (nginx/permtracker.conf, pt_busy_seen). Only a browser that draws the page
    asks for the image, so scripts turned away are not in it. A person is one
    address and browser; the page reloads itself, so one person can see it
    several times, which `views` counts. `busyPeople` saw "busy for a moment"
    (the whole server was full, the sign it is too small); the rest saw "one
    moment" (their own address asked too fast). Each of the last 7 days (UTC)
    and the last 24 hours. None when the log can't be read (nginx not set up
    for it)."""
    files = sorted(log.parent.glob(log.name + "*")) if log.parent.exists() else []
    if not files:
        return None
    week_ago = now - 7 * 86_400
    day_ago = now - 86_400
    days: dict[str, dict] = {}
    last: dict = {"views": 0, "people": set(), "busyPeople": set(), "busy": 0, "slowDown": 0}
    latest = None
    for f in files:
        if f.suffix == ".gz":
            continue  # the rotation keeps these uncompressed; a stray .gz is older than a week
        try:
            lines = f.read_text(errors="replace").splitlines()
        except OSError:
            return None
        for ln in lines:
            m = BUSY_LINE.match(ln)
            # 200: the image was served (refused hits are logged elsewhere).
            if not m or m.group(2) != "200" or m.group(4) not in ("503", "429"):
                continue
            if NOT_PERSON.search(m.group(5)):
                continue
            try:
                t = datetime.fromisoformat(m.group(1)).timestamp()
            except ValueError:
                continue
            if t < week_ago:
                continue
            who = (m.group(3), m.group(5))
            busy = m.group(4) == "503"
            d = days.setdefault(time.strftime("%Y-%m-%d", time.gmtime(t)),
                                {"views": 0, "people": set(), "busyPeople": set()})
            d["views"] += 1
            d["people"].add(who)
            if busy:
                d["busyPeople"].add(who)
            if t >= day_ago:
                last["views"] += 1
                last["people"].add(who)
                if busy:
                    last["busyPeople"].add(who)
                last["busy" if busy else "slowDown"] += 1
            latest = max(latest or t, t)
    return {
        "last24h": {"views": last["views"], "people": len(last["people"]), "busyPeople": len(last["busyPeople"]),
                    "busyViews": last["busy"], "slowDownViews": last["slowDown"]},
        "days": [{"day": k, "views": v["views"], "people": len(v["people"]), "busyPeople": len(v["busyPeople"])}
                 for k, v in sorted(days.items())],
        "lastAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(latest)) if latest else None,
    }


def p95(xs):
    if not xs:
        return None
    s = sorted(xs)
    return s[min(len(s) - 1, int(round(0.95 * (len(s) - 1))))]


def main():
    HERE.mkdir(exist_ok=True)
    now = time.time()
    total, idle = cpu_counters()
    rx, tx = net_counters()
    prev = {}
    try:
        prev = json.loads(STATE.read_text())
    except (OSError, ValueError):
        pass
    STATE.write_text(json.dumps({"t": now, "total": total, "idle": idle, "rx": rx, "tx": tx}))

    cpu = net = None
    dt = now - prev.get("t", now)
    if 60 < dt < 3_600 and total > prev.get("total", total):
        cpu = round(100 * (1 - (idle - prev["idle"]) / (total - prev["total"])), 1)
        if rx >= prev.get("rx", rx) and tx >= prev.get("tx", tx):
            mbps = 8 * max(rx - prev["rx"], tx - prev["tx"]) / dt / 1e6
            net = round(100 * mbps / NIC_MBPS, 3)

    m = meminfo()
    mem = round(100 * (m["MemTotal"] - m["MemAvailable"]) / m["MemTotal"], 1)
    disk = shutil.disk_usage("/")

    samples = []
    try:
        samples = [json.loads(x) for x in SAMPLES.read_text().splitlines() if x.strip()]
    except (OSError, ValueError):
        pass
    samples = [s for s in samples if now - s["t"] <= WEEK_S]
    # Free disk in GB per sample since Oct 10 2026, so the report can say when
    # the disk will be full instead of saying it is full (disk_hours_to_full).
    samples.append({"t": round(now), "cpu": cpu, "mem": mem, "net": net,
                    "disk": round(disk.free / 1024 ** 3, 1)})
    tmp = SAMPLES.with_suffix(".tmp")
    tmp.write_text("".join(json.dumps(s) + "\n" for s in samples))
    tmp.replace(SAMPLES)

    backups = sorted((APP / "backups").glob("db-*.sql.zst"))
    last_ok = None
    try:
        at, size, name = (APP / "backups" / "LAST_OK").read_text().split()
        last_ok = {"at": at, "bytes": int(size), "file": name}
    except (OSError, ValueError):
        pass
    # The copy in Cloudflare R2 (bin/permtracker-backup) and the monthly proof
    # that it restores (bin/permtracker-restore-test).
    offsite_ok = restore_ok = None
    try:
        at, size, name = (APP / "backups" / "OFFSITE_OK").read_text().split()
        offsite_ok = {"at": at, "bytes": int(size), "file": name}
    except (OSError, ValueError):
        pass
    try:
        count, size = (APP / "backups" / "OFFSITE_SIZE").read_text().split()
        offsite_ok = {**(offsite_ok or {}), "bucketObjects": int(count), "bucketBytes": int(size)}
    except (OSError, ValueError):
        pass
    try:
        at, name, tables, rows = (APP / "backups" / "RESTORE_OK").read_text().split()
        restore_ok = {"at": at, "file": name, "tables": int(tables), "rows": int(rows)}
    except (OSError, ValueError):
        pass

    # The two sealed copies added Sep 29 2026: the server's secrets and config
    # (bin/permtracker-backup-server) and the Convex export (the convex-backup
    # workflow, stored by the deploy script's convex-backup action).
    sealed = {}
    for key, fname in (("serverOk", "SERVER_OK"), ("convexOk", "CONVEX_OK")):
        try:
            at, size, name = (APP / "backups" / fname).read_text().split()
            sealed[key] = {"at": at, "bytes": int(size), "file": name}
        except (OSError, ValueError):
            sealed[key] = None

    slot = (APP / "app" / "active").read_text().strip() if (APP / "app" / "active").exists() else None
    release = None
    if slot and (APP / "app" / "slots" / slot).is_symlink():
        release = os.path.basename(os.readlink(APP / "app" / "slots" / slot))

    failed = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain"],
                            capture_output=True, text=True).stdout.split("\n")
    timers = subprocess.run(["systemctl", "list-timers", "--no-legend", "--plain", "permtracker*"],
                            capture_output=True, text=True).stdout
    db_bytes = sum(p.stat().st_size for p in (APP / "db" / "data.sqld").rglob("*") if p.is_file())
    data_file = APP / "db" / "data.sqld" / "dbs" / "default" / "data"
    data_bytes = data_file.stat().st_size if data_file.exists() else None

    # The watchdog's repairs (bin/permtracker-watchdog), last 24 hours.
    repairs = []
    try:
        day_ago = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now - 86_400))
        repairs = [ln for ln in (HERE / "repairs.log").read_text().splitlines() if ln[:20] >= day_ago]
    except OSError:
        pass

    # The page-cache cap (bin/permtracker-prune, every 30 minutes): when it last
    # ran, what the live and standby copies hold, and whether free disk had
    # fallen below its floor. Missing or stale here means the cap stopped.
    page_cache = None
    try:
        pr = json.loads((HERE / "prune.json").read_text())
        by_role = {r["role"]: r for r in pr.get("releases", [])}
        page_cache = {
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(pr["at"])),
            "liveGB": (by_role.get("live") or {}).get("gb"),
            "standbyGB": (by_role.get("standby") or {}).get("gb"),
            "freedGB": round(sum(r.get("freedGB", 0) for r in pr.get("releases", [])), 2),
            "tight": bool(pr.get("tight")),
        }
    except (OSError, ValueError, KeyError):
        pass

    week = [s for s in samples if s.get("cpu") is not None]
    doc = {
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
        "now": {
            "cpuPct": cpu, "memPct": mem, "netPct": net,
            "load1": float(open("/proc/loadavg").read().split()[0]),
            "diskPct": round(100 * disk.used / disk.total, 1),
            "diskFreeGB": round(disk.free / 1024 ** 3, 1),
            "diskHoursToFull": disk_hours_to_full(samples, now),
            "dbBytes": db_bytes,
            "dbDataBytes": data_bytes,
            "lockedMb": m.get("Mlocked", 0) // 1024,
            "swapUsedMb": (m.get("SwapTotal", 0) - m.get("SwapFree", 0)) // 1024,
            "memAvailableMb": m.get("MemAvailable", 0) // 1024,
            "uptimeH": round(float(open("/proc/uptime").read().split()[0]) / 3600, 1),
        },
        "idle": {
            "hours": round((now - samples[0]["t"]) / 3600, 1),
            "samples": len(samples),
            "cpuP95": p95([s["cpu"] for s in week]),
            "memP95": p95([s["mem"] for s in samples]),
            "memMin": min(s["mem"] for s in samples),
            "netP95": p95([s["net"] for s in week if s.get("net") is not None]),
        },
        "backup": {"lastOk": last_ok, "count": len(backups), "offsiteOk": offsite_ok, "restoreOk": restore_ok,
                   **sealed},
        # The live slot's second copy (one per CPU) is a service too; the old
        # slot's second copy is stopped on purpose and not listed.
        "services": {u: active(u) for u in SERVICES + ([f"permtracker-web@{slot}2"] if slot else [])},
        "failedUnits": [ln.split()[0] for ln in failed if ln.strip()],
        # The defense writes to the same log; it is not a restart, so it is
        # counted apart (the Oct 3 report called five defense on/off pairs
        # "the watchdog restarted something 10 times").
        "repairs24h": [r for r in repairs if " defend: " not in r][-5:],
        "repairCount24h": sum(1 for r in repairs if " defend: " not in r),
        "defense24h": [r for r in repairs if " defend: " in r and " defend: would " not in r][-5:],
        "defenseCount24h": sum(1 for r in repairs if " defend: " in r and " defend: would " not in r),
        "underAttack24h": sum(1 for r in repairs if " defend: Under Attack Mode on" in r),
        "timersEnabled": len(re.findall(r"permtracker[^\s]*\.timer", timers)),
        "timers": sorted(set(re.findall(r"permtracker[^\s]*\.timer", timers))),
        "slot": {"active": slot, "release": release},
        "pageCache": page_cache,
        # People shown "busy for a moment" or "one moment" (see busy_seen).
        "busySeen": busy_seen(now),
    }

    token = (APP / "secrets" / "db_rw.jwt").read_text().strip()
    body = json.dumps({"requests": [
        {"type": "execute", "stmt": {
            "sql": "INSERT OR REPLACE INTO perm_docs (key, json, computed_at) VALUES (?, ?, ?)",
            "args": [{"type": "text", "value": "server_health"},
                     {"type": "text", "value": json.dumps(doc)},
                     {"type": "integer", "value": str(int(now * 1000))}]}},
        {"type": "close"}]}).encode()
    req = urllib.request.Request("http://127.0.0.1:8080/v2/pipeline", body,
                                 {"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        res = json.load(r)["results"][0]
    if res.get("type") != "ok":
        raise SystemExit(f"server_health not written: {res.get('error', {}).get('message')}")
    print(f"cpu={cpu} mem={mem} disk={doc['now']['diskPct']} samples={len(samples)}")


if __name__ == "__main__":
    main()
