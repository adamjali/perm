#!/bin/bash
# Lock the database file in RAM. Two reasons, both measured on 2026-09-28:
# every read then comes from memory, and the machine's used memory stays above
# Oracle's idle line (an Always Free A1 instance is reclaimed when, over 7
# days, p95 CPU, network AND memory are all under 20%; at rest it sat at 11%).
# Cap: never lock more than 6 GB, half the machine.
set -euo pipefail
D=/srv/permtracker/db/data.sqld/dbs/default
size=$(stat -c %s "$D/data")
# Over the cap it waits, then exits cleanly for systemd to start it again and
# re-check the size. It slept forever until Oct 19 2026, so the unit's 6-hour
# RuntimeMaxSec killed it as "failed" four times a day from Oct 9, when the
# database passed 6 GB (the morning report now says when nothing is locked).
if [ "$size" -gt $((6*1024*1024*1024)) ]; then echo "database is $size bytes, over the 6 GB cap; not locking"; exec sleep 20700; fi
exec vmtouch -l -q "$D/data"
