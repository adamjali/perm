#!/opt/permtracker-oci/bin/python3
"""Keeps Oracle's nightly copies of this server's boot disk inside the free five.

Oracle's Always Free tier holds five volume backups at no charge; a sixth is
billed. Oracle's own schedule (the permtracker-daily-keep3 policy, assigned to
the boot disk) makes one copy a night, about 2 AM Eastern, but never deleted a
copy once it expired: the Oct 4 copy expired Oct 7 and was still held on Oct 12,
the count reached nine, and the any-spend alarm fired. So at 3:45 AM this job:

  0. checks the schedule is still attached to the disk, and attaches it again
     when it isn't;
  1. checks last night's copy exists (made in the last 26 hours) and that
     Oracle marks it Always free;
  2. deletes this disk's copies until KEEP - 1 remain, billed ones before free
     ones, so tomorrow's copy is the fourth, never the sixth, and one slot
     stays free for a copy made by hand before a risky change.

It makes no copies itself (owner's call, Oct 13 2026): the one copy it made
through the API, on Oct 13, Oracle billed with three held, while every copy
Oracle's schedule made inside the five was free. Deleting about 22 hours before
the next scheduled copy also keeps a just-deleted copy from being counted
against it. A failed check exits 1: the unit shows failed and permtracker-alarm
emails within five minutes. DISKCOPY_OK records the last run that found a fresh
copy, for the health report.

The server signs in to Oracle as itself (an instance principal): the dynamic
group permtracker-server and the policy permtracker-disk-copies let it, and no
key is stored anywhere. Since Oct 13 2026 that policy also grants manage
all-resources in tenancy (owner's call, for the most room to act), so the job
can see and attach the schedule. /etc/permtracker/disk-copies.env names the
disk (BOOT_VOLUME_ID).

  permtracker-disk-copies            the daily run
  permtracker-disk-copies --dry-run  say what it would delete; change nothing
  permtracker-disk-copies --list     list this disk's copies
"""
from __future__ import annotations

import json
import os
import pathlib
import sys
import time
import urllib.request
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

KEEP = 4          # copies held after a run; the fifth free slot stays spare
FREE_LIMIT = 5    # Oracle's Always Free allowance of volume backups
MARKER = pathlib.Path("/srv/permtracker/backups/DISKCOPY_OK")
METADATA = "http://169.254.169.254/opc/v2/instance/"
ET = ZoneInfo("America/New_York")

LIVE = {"AVAILABLE"}
PENDING = {"CREATING", "REQUEST_RECEIVED"}
BROKEN = {"FAULTY"}
GONE = {"TERMINATING", "TERMINATED"}
# A copy being made for longer than this is stuck, not busy.
STUCK_AFTER_S = 6 * 3600
DELETE_WAIT_S = 15 * 60
POLL_S = 30
# Oracle's schedule makes one copy a night; a newest copy older than this means it stopped.
FRESH_S = 26 * 3600


def free_tagged(copy) -> bool:
    """Whether Oracle marks the copy Always Free. Read on Oct 12 2026: the five
    free copies carried {"orcl-cloud": {"free-tier-retained": "true"}} and the
    four billed ones no system tags at all, so no tag means billed."""
    ns = (getattr(copy, "system_tags", None) or {}).get("orcl-cloud") or {}
    return str(ns.get("free-tier-retained", "")).lower() == "true"



def plan(copies, now_s: float, keep: int = KEEP):
    """Which copies to delete, or why not to start.

    Returns (to_delete, skip_reason, problem). A copy being made by someone else
    skips the run quietly; one stuck for six hours is a problem. Broken copies
    go first, then billed ones (they cost money), then the oldest free ones,
    until keep - 1 remain.
    """
    pending = [c for c in copies if c.lifecycle_state in PENDING]
    if pending:
        oldest = min(pending, key=lambda c: c.time_created)
        age = now_s - oldest.time_created.timestamp()
        if age > STUCK_AFTER_S:
            return [], None, f"a copy has been in progress for {age / 3600:.0f} hours ({oldest.display_name})"
        return [], f"a copy is already being made ({oldest.display_name})", None
    broken = [c for c in copies if c.lifecycle_state in BROKEN]
    live = sorted((c for c in copies if c.lifecycle_state in LIVE), key=lambda c: (free_tagged(c), c.time_created))
    excess = len(broken) + len(live) - (keep - 1)
    if excess <= 0:
        return [], None, None
    return (broken + live)[:excess], None, None



def write_marker(path: pathlib.Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def wait_for(get, copy_id: str, done: set[str], timeout_s: float, sleep=time.sleep, clock=time.monotonic):
    """Poll one copy until its state is in `done`. A copy that no longer exists
    counts as terminated. Returns the final state, or raises TimeoutError."""
    start = clock()
    while True:
        try:
            state = get(copy_id).data.lifecycle_state
        except Exception as exc:  # the SDK's ServiceError, or a stand-in's
            if getattr(exc, "status", None) == 404 and "TERMINATED" in done:
                return "TERMINATED"
            raise
        if state in done:
            return state
        if state in BROKEN:
            raise RuntimeError(f"Oracle marked copy {copy_id[-12:]} {state}")
        if clock() - start > timeout_s:
            raise TimeoutError(f"copy {copy_id[-12:]} still {state} after {timeout_s / 60:.0f} minutes")
        sleep(POLL_S)


def disk_copies(client, compartment: str, volume_id: str):
    """Every copy of this one disk, in any state. The filter is asked of Oracle
    and checked again here: nothing of another disk is ever touched."""
    out, page = [], None
    while True:
        kw = {"compartment_id": compartment, "boot_volume_id": volume_id}
        if page:
            kw["page"] = page
        resp = client.list_boot_volume_backups(**kw)
        out.extend(c for c in resp.data if c.boot_volume_id == volume_id)
        page = getattr(resp, "next_page", None)
        if not page:
            return out


SCHEDULE_NAME = "permtracker-daily-keep3"


def ensure_schedule(client, compartment: str, volume_id: str, *, dry_run: bool = False, make_details=None) -> str | None:
    """Attach Oracle's nightly schedule to the disk when it isn't attached.
    Returns a problem sentence, or None when the schedule is (now) attached."""
    attached = client.get_volume_backup_policy_asset_assignment(asset_id=volume_id).data
    if attached:
        return None
    policies = [p for p in client.list_volume_backup_policies(compartment_id=compartment).data
                if p.display_name == SCHEDULE_NAME]
    if not policies:
        return f"Oracle's schedule {SCHEDULE_NAME} is gone; no copy will be made tonight"
    if dry_run:
        print(f"disk copies: the schedule isn't attached; a run would attach {SCHEDULE_NAME}")
        return None
    client.create_volume_backup_policy_assignment(make_details(volume_id, policies[0].id))
    print(f"disk copies: the schedule wasn't attached; attached {SCHEDULE_NAME} again")
    return None


def run(client, compartment: str, volume_id: str, *, now: datetime, dry_run: bool = False,
        sleep=time.sleep, clock=time.monotonic, marker: pathlib.Path = MARKER) -> int:
    copies = [c for c in disk_copies(client, compartment, volume_id) if c.lifecycle_state not in GONE]
    to_delete, skip, problem = plan(copies, now.timestamp())
    if problem:
        print(f"disk copies: {problem}")
        return 1
    if skip:
        print(f"disk copies: {skip}; checking tomorrow")
        return 0
    live = sorted((c for c in copies if c.lifecycle_state in LIVE), key=lambda c: c.time_created)
    newest = live[-1] if live else None
    fresh = newest is not None and now.timestamp() - newest.time_created.timestamp() < FRESH_S
    newest_free = newest is not None and free_tagged(newest)
    held = [c for c in copies if c.lifecycle_state in LIVE | BROKEN]
    if newest is not None:
        when = newest.time_created.astimezone(ET).strftime("%b %-d %-I:%M %p %Z")
        print(f"disk copies: {len(held)} held; newest made {when}, {'free' if newest_free else 'billed'}")
    else:
        print("disk copies: no copies held")
    for c in to_delete:
        made = c.time_created.astimezone(ET).strftime("%b %-d %Y %-I:%M %p %Z")
        print(f"  delete: {c.display_name} (made {made}, {c.lifecycle_state}, {'free' if free_tagged(c) else 'billed'})")
    if dry_run:
        print("dry run: nothing changed")
        return 0
    for c in to_delete:
        client.delete_boot_volume_backup(c.id)
        wait_for(client.get_boot_volume_backup, c.id, {"TERMINATED"}, DELETE_WAIT_S, sleep, clock)
    after = len(held) - len(to_delete)
    if fresh:
        try:
            write_marker(marker, f"{now.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {after} "
                                 f"{'yes' if newest_free else 'no'}\n")
        except OSError as exc:
            print(f"disk copies: could not record the run ({exc})")
            return 1
    if not fresh:
        print("disk copies: Oracle made no copy in the last 26 hours; is its schedule permtracker-daily-keep3 "
              "assigned to the boot disk?")
        return 1
    if after > FREE_LIMIT:
        print(f"disk copies: {after} copies held, over the free {FREE_LIMIT}; Oracle bills the extra")
        return 1
    if not newest_free:
        gone = " (deleted, billed copies go first)" if newest in to_delete else ""
        print(f"disk copies: last night's copy isn't marked Always free, so Oracle billed it{gone}")
        return 1
    print(f"disk copies: {after} held, newest free")
    return 0


def list_copies(client, compartment: str, volume_id: str) -> int:
    for c in sorted(disk_copies(client, compartment, volume_id), key=lambda c: c.time_created):
        when = c.time_created.astimezone(ET).strftime("%a %b %-d %Y %-I:%M %p %Z")
        free = "free" if free_tagged(c) else "billed"
        print(f"{when}  {c.lifecycle_state:<12} {free:<6} {c.display_name}")
    return 0


def main(argv: list[str]) -> int:
    import oci  # imported here so the tests run without Oracle's library

    volume_id = os.environ.get("BOOT_VOLUME_ID", "")
    if not volume_id.startswith("ocid1.bootvolume."):
        print("disk copies: BOOT_VOLUME_ID is not set (/etc/permtracker/disk-copies.env)")
        return 1
    req = urllib.request.Request(METADATA, headers={"Authorization": "Bearer Oracle"})
    compartment = json.load(urllib.request.urlopen(req, timeout=10))["compartmentId"]
    signer = oci.auth.signers.InstancePrincipalsSecurityTokenSigner()
    client = oci.core.BlockstorageClient(config={}, signer=signer)

    def assignment(vid: str, policy_id: str):
        return oci.core.models.CreateVolumeBackupPolicyAssignmentDetails(asset_id=vid, policy_id=policy_id)

    try:
        if "--list" in argv:
            return list_copies(client, compartment, volume_id)
        problem = ensure_schedule(client, compartment, volume_id, dry_run="--dry-run" in argv, make_details=assignment)
        code = run(client, compartment, volume_id, now=datetime.now(timezone.utc), dry_run="--dry-run" in argv)
        if problem:
            print(f"disk copies: {problem}")
            return 1
        return code
    except oci.exceptions.ServiceError as exc:
        print(f"disk copies: Oracle refused ({exc.status} {exc.code})")
        return 1
    except (TimeoutError, RuntimeError) as exc:
        print(f"disk copies: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
