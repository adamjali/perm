[Unit]
Description=PERM Tracker nightly database backup
After=permtracker-db.service
[Service]
# A hung run stops here instead of holding its slot forever (a dump takes about 2 minutes).
TimeoutStartSec=2h
Type=oneshot
User=permtracker
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/bin/permtracker-backup
