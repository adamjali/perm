[Unit]
Description=PERM Tracker: Oracle's nightly copies of the boot disk, checked and kept inside the free five
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=permtracker
# Deleting a copy takes minutes; a hung run stops here instead of holding its slot.
TimeoutStartSec=45m
Nice=19
# The disk's ID (BOOT_VOLUME_ID); an identifier, not a secret, kept off the public repo.
EnvironmentFile=/etc/permtracker/disk-copies.env
ExecStart=/usr/local/bin/permtracker-disk-copies
