[Unit]
Description=Schedule for permtracker-cron@dispatch-newsworthy-evening
# The evening newsworthy check: what moved since the morning report, emailed to
# the owner only when something did, at 8:30 PM Eastern.
[Timer]
OnCalendar=*-*-* 20:30:00 America/New_York
Persistent=true
Unit=permtracker-cron@dispatch-newsworthy-evening.service
[Install]
WantedBy=timers.target
