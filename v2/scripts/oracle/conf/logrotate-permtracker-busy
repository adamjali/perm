# /etc/logrotate.d/permtracker-busy: the refusal pages' counting log
# (nginx location /__pt/busy-seen). Ten days kept, so the health check always
# has the full week it reports. Readable by the permtracker group only.
/var/log/permtracker-busy/seen.log {
	daily
	rotate 10
	missingok
	notifempty
	maxsize 50M
	create 0640 root permtracker
	postrotate
		invoke-rc.d nginx rotate >/dev/null 2>&1
	endscript
}

# The automatic defense's request log (nginx pt_defend). It reads only the last
# few minutes, so two days are kept; maxsize rotates it early on a heavy day.
/var/log/permtracker-busy/defend.log {
	daily
	rotate 2
	missingok
	notifempty
	maxsize 300M
	create 0640 root permtracker
	postrotate
		invoke-rc.d nginx rotate >/dev/null 2>&1
	endscript
}
