{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    // Node's --experimental-strip-types requires the .ts specifier on a
    // relative import, and scripts/*.mts run that way. noEmit is already on.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-rfi/types/**/*.ts",
    ".next-rfi/dev/types/**/*.ts",
    ".next-queue-dev/types/**/*.ts",
    ".next-queue-dev/dev/types/**/*.ts",
    ".next-dev-hero/types/**/*.ts",
    ".next-dev-hero/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test-utils",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.stories.tsx"
  ]
}
